[Unit]
Description=Lab uplink: DHCP and DNS for the LAN ports
Requires=lab-uplink-setup.service
After=lab-uplink-setup.service systemd-networkd.service lab-uplink-nft.service
Wants=lab-uplink-nft.service
ConditionPathExists=/run/lab-uplink/dnsmasq.conf

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --conf-file=/run/lab-uplink/dnsmasq.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
