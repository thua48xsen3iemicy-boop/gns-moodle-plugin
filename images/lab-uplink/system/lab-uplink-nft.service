[Unit]
Description=Lab uplink: firewall and NAT
Requires=lab-uplink-setup.service
After=lab-uplink-setup.service
Before=lab-uplink-pppoe.service lab-uplink-dnsmasq.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /run/lab-uplink/nftables.nft
ExecStop=/usr/sbin/nft flush ruleset

[Install]
WantedBy=multi-user.target
