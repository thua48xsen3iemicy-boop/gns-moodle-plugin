#!/bin/bash
# Semi-manual provisioning of Proxmox nodes: secrets, node agents, slot and manager LXCs.
# Runs as root on a cluster node. Every change inside an LXC goes through pct (push/exec), so the
# components keep reading their secrets from the same local paths as before. pct only reaches the
# CTs of its own node: slot and agent run on every node with slots, manager/check/enable on the
# manager's node. Nodes and IPs of the CTs are read from /etc/pve/nodes, which every node sees.
#
#   install/lab-provision <step> [args]      settings: ${LAB_CONF:-/mnt/pve/cfs/secrets/lab.conf}
#
# Steps, in order (install/README.md): secrets, venv slot, slot, agent, venv manager, manager,
# moodle, check, enable. Every step can be repeated: existing secrets are never regenerated.
# 'deploy' runs them all from one node, over the cluster's root ssh, after creating the missing CTs
# ('template', 'create'); 'reset' destroys the stand for a fresh deploy.
# Guest scripts are single-quoted on purpose: they expand inside the CT.
# shellcheck disable=SC2016
set -euo pipefail
umask 077
# pct creates /var/lib/lxc/<vmid> with the umask it inherits: under 077 the directory is 0700 and an
# unprivileged CT cannot open its rootfs ("Failed to open /var/lib/lxc/<vmid>/rootfs: Permission denied").
pct() { (umask 022; command pct "$@"); }

CONF=${LAB_CONF:-/mnt/pve/cfs/secrets/lab.conf}
ID_OFFSET=100000  # Standard unprivileged mapping: guest uid N is host uid N + 100000
GNS3_VERSION=2.2.61  # The only GNS3 server the slot supports (slot/README.md)
LENIENT=0  # 1: CTs of SLOTS and MANAGER_VMID may be missing (they are being created or destroyed)

log() { printf '==> %s\n' "$*"; }
warn() { printf 'WARNING: %s\n' "$*" >&2; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: lab-provision <step> [args]
  release build|verify|list  prepare/check immutable releases; does not apply them (RELEASES.md)
  secrets           generate CAs, certificates, tokens and config files into SECRETS_DIR (any node)
  venv slot|manager build the Python venv of the slot or manager code on CephFS
  slot [VMID...]    tag a stopped slot LXC of this node, push slot.env, lab-slot-init, lab-slot.service, then
                    save its clean state (the snapshot the agent rolls back to after every session)
  snapshot [VMID...]  save the clean state again, without pushing anything (the slot must be stopped)
  agent             prepare CephFS directories and install the node agent on this node
  manager           mounts, packages, configs and services of the manager LXC (with nginx)
  moodle            give Moodle the web CA and print the plugin settings
  check             this node's agent and slots; on the manager's node also the manager and all agents
  enable [VMID...]  make the slots available in the manager (slot-enable), all of SLOTS by default
  reconcile VMID [--yes]
                    after an agent quarantine (COMMAND_UNCERTAIN, SLOT_QUARANTINED): clear the agent's
                    uncertain mark of a stopped slot, on the node of the slot. Without --yes only shows
                    what it would do (TROUBLESHOOTING.md)

  template          build the slot template CT (Ubuntu 24.04, GNS3 2.2.61) from SLOT_TEMPLATE
  create            create the missing manager CT (CREATE_MANAGER) and slot CTs (CREATE_SLOTS)
  deploy            template, create and all the steps above on every node, from any node (ssh)
  reset [--yes] [--secrets] [--template]
                    destroy the manager and slot CTs, their ownership records on the agents, the
                    student directories (renamed, not deleted); --secrets also moves SECRETS_DIR
                    aside (lab.conf and own files stay), --template also destroys the slot template
EOF
}

load_conf() {
  [[ $EUID == 0 ]] || die "run as root on the Proxmox node"
  type -P pct >/dev/null || die "pct not found: run on a Proxmox node"  # type -P: the function above is not the binary
  [[ -f $CONF ]] || die "no $CONF: copy install/lab.conf.example there and edit it"
  # shellcheck source=/dev/null
  . "$CONF"
  local v
  for v in CEPH_ROOT REPO_DIR STUDENTS_DIR SECRETS_DIR AGENT_DOMAIN MANAGER_VMID SLOTS \
           PUBLIC_NAME MOODLE_URL MOODLE_IP SITE_SLUG; do
    [[ -n ${!v:-} ]] || die "$v is not set in $CONF"
  done
  CEPH_ROOT=${CEPH_ROOT%/} REPO_DIR=${REPO_DIR%/} MOODLE_URL=${MOODLE_URL%/} STUDENTS_DIR=${STUDENTS_DIR%/}
  IMAGES_DIR=${IMAGES_DIR:-} IMAGES_DIR=${IMAGES_DIR#/} IMAGES_DIR=${IMAGES_DIR%/}
  [[ -z $IMAGES_DIR || $IMAGES_DIR =~ ^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$ ]] ||
    die "IMAGES_DIR must be a relative path below CEPH_ROOT of plain directory names"
  CLEAN_SNAPSHOT=${CLEAN_SNAPSHOT:-lab-clean}  # LAB_CLEAN_SNAPSHOT of the agent
  [[ $CLEAN_SNAPSHOT =~ ^[A-Za-z][A-Za-z0-9_-]{0,39}$ ]] ||
    die "CLEAN_SNAPSHOT must be a Proxmox snapshot name: a letter, then letters, digits, _ and -, up to 40"
  INET_BRIDGE=${INET_BRIDGE:-} INET_VLAN=${INET_VLAN:-}  # The labs' internet uplink: net1 of the slots (docs/lab-uplink/TASK.md)
  [[ -z $INET_BRIDGE && -z $INET_VLAN ]] || {
    [[ $INET_BRIDGE =~ ^[A-Za-z][A-Za-z0-9_.-]{0,14}$ ]] || die "INET_BRIDGE must be a Proxmox bridge name, set together with INET_VLAN"
    [[ $INET_VLAN =~ ^[0-9]{1,4}$ ]] && ((10#$INET_VLAN >= 1 && 10#$INET_VLAN <= 4094)) ||
      die "INET_VLAN must be a VLAN tag 1-4094, set together with INET_BRIDGE"
    INET_VLAN=$((10#$INET_VLAN))
  }
  SLOT_CLONE=${SLOT_CLONE:-full}
  [[ $SLOT_CLONE == full || $SLOT_CLONE == linked ]] || die "SLOT_CLONE must be full or linked, got '$SLOT_CLONE'"
  [[ $REPO_DIR == "$CEPH_ROOT"/* ]] || die "REPO_DIR must be below CEPH_ROOT"
  CODE_DIR=${REPO_DIR#"$CEPH_ROOT"/}/slot  # LAB_CODE_DIR of the agent and the manager
  NODE=$(hostname)
  NODE_FQDN=$NODE.$AGENT_DOMAIN
  S=$SECRETS_DIR

  # NODES="pve1=10.10.12.9 pve2=10.10.12.10"; a one-node lab.conf has NODE_IP for this node instead.
  if [[ -z ${NODES:-} ]]; then
    [[ -n ${NODE_IP:-} ]] || die "NODES is not set in $CONF"
    NODES="$NODE=$NODE_IP"
  fi
  declare -gA NODE_IPS=() SLOT_NODE=()
  NODE_NAMES=()
  local pair n
  for pair in $NODES; do
    n=${pair%%=*}
    [[ $pair =~ ^[A-Za-z0-9][A-Za-z0-9-]*=[0-9]+(\.[0-9]+){3}$ ]] || die "invalid NODES entry: $pair (expected <node>=<IP>)"
    [[ -z ${NODE_IPS[$n]:-} ]] || die "node $n is twice in NODES"
    [[ -d /etc/pve/nodes/$n ]] || die "NODES: $n is not a node of this cluster"
    NODE_IPS[$n]=${pair#*=}
    NODE_NAMES+=("$n")
  done

  read -ra SLOT_IDS <<<"$SLOTS"
  local id lo hi
  for id in "$MANAGER_VMID" "${SLOT_IDS[@]}" ${MOODLE_VMID:-}; do
    [[ $id =~ ^[0-9]+$ ]] || die "invalid VMID: $id"
  done
  load_plan
  LOCAL_SLOTS=()
  for id in "${SLOT_IDS[@]}"; do
    [[ ! -v SLOT_NODE[$id] ]] || die "slot $id is twice in SLOTS"
    n=$(planned_node "$id" "slot $id from SLOTS")
    SLOT_NODE[$id]=$n
    [[ -n $n ]] || continue
    [[ -n ${NODE_IPS[$n]:-} ]] || die "slot $id is on node $n, which is not in NODES"
    [[ $n != "$NODE" ]] || LOCAL_SLOTS+=("$id")
  done
  MANAGER_NODE=$(planned_node "$MANAGER_VMID" "MANAGER_VMID $MANAGER_VMID")
  # Each agent accepts the VMID range of its own node's slots, so the manager must stay outside its node's.
  if [[ -n $MANAGER_NODE ]] && read -r lo hi < <(node_range "$MANAGER_NODE"); then
    ((MANAGER_VMID < lo || MANAGER_VMID > hi)) ||
      die "MANAGER_VMID is inside the slot VMID range of node $MANAGER_NODE ($lo-$hi)"
  fi
  if [[ -n $TEMPLATE_VMID ]] && read -r lo hi < <(node_range "$TEMPLATE_NODE"); then
    ((TEMPLATE_VMID < lo || TEMPLATE_VMID > hi)) ||
      die "SLOT_TEMPLATE is inside the slot VMID range of node $TEMPLATE_NODE ($lo-$hi)"
  fi
}

# Optional CTs the script creates itself: CREATE_MANAGER="<node>:<ip>",
# CREATE_SLOTS="<vmid>=<node>:<ip> ...", SLOT_TEMPLATE="<vmid>=<node>:<ip|dhcp>".
load_plan() {
  declare -gA PLAN_NODE=() PLAN_IP=()
  local entry id rest used=" "
  plan_entry() {  # plan_entry <vmid> <node>:<ip> <what>
    local node=${2%%:*} ip=${2#*:}
    [[ $2 == *:* && $node =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]] || die "$3: expected <node>:<ip>, got '$2'"
    [[ -d /etc/pve/nodes/$node ]] || die "$3: $node is not a node of this cluster"
    [[ $ip =~ ^[0-9]+(\.[0-9]+){3}$ || ($ip == dhcp && $1 == "${TEMPLATE_VMID:-}") ]] ||
      die "$3: invalid IP '$ip'"
    [[ $ip == dhcp || $used != *" $ip "* ]] || die "$3: IP $ip is planned twice"
    used+="$ip "
    PLAN_NODE[$1]=$node PLAN_IP[$1]=$ip
  }
  TEMPLATE_VMID='' TEMPLATE_NODE=''
  if [[ -n ${SLOT_TEMPLATE:-} ]]; then
    TEMPLATE_VMID=${SLOT_TEMPLATE%%=*}
    [[ $SLOT_TEMPLATE == *=* && $TEMPLATE_VMID =~ ^[0-9]+$ ]] ||
      die "SLOT_TEMPLATE: expected <vmid>=<node>:<ip|dhcp>, got '$SLOT_TEMPLATE'"
    [[ $TEMPLATE_VMID != "$MANAGER_VMID" && " $SLOTS " != *" $TEMPLATE_VMID "* ]] ||
      die "SLOT_TEMPLATE $TEMPLATE_VMID is also the manager or a slot"
    plan_entry "$TEMPLATE_VMID" "${SLOT_TEMPLATE#*=}" SLOT_TEMPLATE
    TEMPLATE_NODE=${PLAN_NODE[$TEMPLATE_VMID]}
  fi
  [[ -z ${CREATE_MANAGER:-} ]] || plan_entry "$MANAGER_VMID" "$CREATE_MANAGER" CREATE_MANAGER
  for entry in ${CREATE_SLOTS:-}; do
    id=${entry%%=*} rest=${entry#*=}
    [[ $entry == *=* && $id =~ ^[0-9]+$ ]] || die "CREATE_SLOTS: expected <vmid>=<node>:<ip>, got '$entry'"
    [[ " $SLOTS " == *" $id "* ]] || die "CREATE_SLOTS: $id is not in SLOTS"
    [[ ! -v PLAN_NODE[$id] ]] || die "CREATE_SLOTS: $id is planned twice"
    plan_entry "$id" "$rest" "CREATE_SLOTS $id"
  done
}

# planned_node <vmid> <what>: the node of an existing CT, else of a planned one. A planned CT that does
# not exist yet is an error outside the create/destroy steps; in them "" stands for "no such CT".
planned_node() {
  local n
  if n=$(ct_node "$1"); then
    [[ -z ${PLAN_NODE[$1]:-} || ${PLAN_NODE[$1]} == "$n" ]] ||
      warn "CT $1 is on $n, the plan in lab.conf says ${PLAN_NODE[$1]} (the existing CT wins)"
    echo "$n"
  elif ((LENIENT)); then
    echo "${PLAN_NODE[$1]:-}"
  elif [[ -n ${PLAN_NODE[$1]:-} ]]; then
    die "$2 does not exist yet: run 'lab-provision create' (or deploy)"
  else
    die "$2 is not a CT of this cluster"
  fi
}

need_node() { [[ -n ${NODE_IPS[$NODE]:-} ]] || die "this node ($NODE) is not in NODES of $CONF"; }

node_range() {  # node_range <node>: "min max" VMID of the slots on that node; fails if it has none
  local id ids=()
  for id in "${SLOT_IDS[@]}"; do [[ ${SLOT_NODE[$id]:-} != "$1" ]] || ids+=("$id"); done
  ((${#ids[@]})) || return 1
  printf '%s\n' "${ids[@]}" | sort -n | sed -n '1p;$p' | paste -sd' '
}

# ------------------------------------------------------------------ LXC helpers

ct_node() {  # Node that hosts CT $1: the cluster filesystem has the configs of every node
  local f
  for f in /etc/pve/nodes/*/lxc/"$1".conf; do
    [[ -f $f ]] || continue
    f=${f#/etc/pve/nodes/}
    echo "${f%%/*}"
    return 0
  done
  return 1
}
ct_conf() {  # Current config of CT $1 on any node, without its snapshot sections
  local n
  n=$(ct_node "$1") || die "CT $1 is not a CT of this cluster"
  awk '/^\[/ {exit} {print}' "/etc/pve/nodes/$n/lxc/$1.conf"
}
ct_local() {
  [[ -f /etc/pve/lxc/$1.conf ]] && return 0
  local n
  n=$(ct_node "$1") || die "CT $1 is not a CT of this cluster"
  die "CT $1 is on node $n: run this step there (this is $NODE)"
}
ct_state() { pct status "$1" | awk '{print $2}'; }
ct_ip() {
  local ip
  ip=$(ct_conf "$1" | sed -n 's/^net0: .*,ip=\([0-9.]*\)\/.*/\1/p')
  [[ -n $ip ]] || die "CT $1: net0 needs a static ip=... ($(ct_conf "$1" | grep '^net0' || echo 'no net0'))"
  echo "$ip"
}
ct_checked() {  # Unprivileged with the standard mapping: host uid = guest uid + ID_OFFSET
  ct_local "$1"
  pct config "$1" | grep -q '^unprivileged: 1' || die "CT $1 must be unprivileged"
  ! pct config "$1" | grep -q '^lxc.idmap' || die "CT $1 has its own lxc.idmap; this script expects the standard one"
}
ct_up() {
  [[ $(ct_state "$1") == running ]] || pct start "$1"
  local i
  for i in $(seq 1 60); do
    pct exec "$1" -- true 2>/dev/null && return 0
    sleep 1
  done
  die "CT $1 did not start"
}
ct_down() { [[ $(ct_state "$1") == stopped ]] || pct shutdown "$1" --timeout 90; }
# ct_sh <vmid> <script> [NAME=value...]: bash inside the CT as root; values go in as environment.
ct_sh() {
  local id=$1 script=$2
  shift 2
  pct exec "$id" -- env "$@" bash -c "umask 022; set -euo pipefail; $script"
}
# ct_push <vmid> <file> <path in CT> <mode> <uid> <gid> (ids inside the CT)
ct_push() { pct push "$1" "$2" "$3" --perms "$4" --user "$5" --group "$6"; }

mp_find() {  # index of the mount point whose guest path is $2
  pct config "$1" | sed -n "s#^mp\([0-9]\{1,3\}\): .*mp=$2\(,.*\)\{0,1\}\$#\1#p" | head -1
}
mp_free() {  # mp_free <vmid> [first index]
  local i
  for i in $(seq "${2:-0}" 255); do
    pct config "$1" | grep -q "^mp$i:" || { echo "$i"; return; }
  done
  die "CT $1 has no free mount point index"
}
mp_ok() {  # mp_ok <vmid> <host path> <guest path> <ro 0|1>: that mount is configured exactly
  local i line
  i=$(mp_find "$1" "$3")
  [[ -n $i ]] || return 1
  line=$(pct config "$1" | sed -n "s/^mp$i: //p")
  [[ $line == "$2,mp=$3"* ]] || return 1
  if [[ $4 == 1 ]]; then [[ $line == *,ro=1* ]]; else [[ $line != *,ro=1* ]]; fi
}
mp_set() {  # mp_set <vmid> <host path> <guest path> <ro 0|1> [first index]; the CT must be stopped
  mp_ok "$1" "$2" "$3" "$4" && return 0
  local i
  i=$(mp_find "$1" "$3")
  [[ -n $i ]] || i=$(mp_free "$1" "${5:-0}")
  log "CT $1: mp$i $2 -> $3 (ro=$4)"
  pct set "$1" "-mp$i" "$2,mp=$3,ro=$4,shared=1"
}
mp_drop() {
  local i
  i=$(mp_find "$1" "$2")
  [[ -z $i ]] || pct set "$1" --delete "mp$i"
}

# ------------------------------------------------------------------ secrets

rand_into() {  # Create a random token file once; never overwrite
  [[ -s $1 ]] || { openssl rand -hex 32 >"$1.tmp" && mv "$1.tmp" "$1"; }
}

make_ca() {  # make_ca <name>: self-signed CA in $S/ca (test mode: the CA keys stay here)
  [[ -s $S/ca/$1.key && -s $S/ca/$1.crt ]] && return 0
  log "CA $1"
  openssl req -new -x509 -newkey rsa:3072 -nodes -sha256 -days 3650 \
    -keyout "$S/ca/$1.key" -out "$S/ca/$1.crt" -subj "/CN=Lab $1" \
    -addext 'basicConstraints=critical,CA:TRUE' -addext 'keyUsage=critical,keyCertSign,cRLSign' 2>/dev/null
}

issue() {  # issue <ca> <dir> <base> <CN> <x509 extensions>; kept once issued
  local ca=$1 dir=$2 base=$3 cn=$4 ext=$5
  [[ -s $dir/$base.key && -s $dir/$base.crt ]] && return 0
  log "certificate $dir/$base.crt (CN=$cn)"
  openssl req -new -newkey rsa:3072 -nodes -sha256 -keyout "$dir/$base.key" -out "$dir/$base.csr" \
    -subj "/CN=$cn" 2>/dev/null
  openssl x509 -req -sha256 -days 397 -in "$dir/$base.csr" -CA "$S/ca/$ca.crt" -CAkey "$S/ca/$ca.key" \
    -set_serial "0x$(openssl rand -hex 16)" -extfile <(printf '%s\n' "$ext") -out "$dir/$base.crt" 2>/dev/null
  rm -f "$dir/$base.csr"
}

san_has() {  # Warn when a kept certificate no longer matches lab.conf
  openssl x509 -in "$1" -noout -ext subjectAltName 2>/dev/null | grep -q "$2" ||
    warn "$1 has no $2 in its SAN: delete it and its .key, then run secrets again"
}

pve_token() {
  local f=$S/manager/pve-token-secret tid='lab-manager@pve!manager'
  log "Proxmox token $tid, pool lab-slots"
  pveum role add LabManager -privs "VM.Audit" 2>/dev/null ||
    pveum role modify LabManager -privs "VM.Audit"
  pveum role add LabManagerNodes -privs "Sys.Audit" 2>/dev/null || true
  pveum user add lab-manager@pve 2>/dev/null || true
  pveum pool add lab-slots 2>/dev/null || true
  local out
  # A repeat may report the slots as members already; a slot in another pool lacks the token's rights.
  out=$(pveum pool modify lab-slots -vms "$(IFS=,; echo "${SLOT_IDS[*]}")" 2>&1) ||
    warn "pool lab-slots: $out (the slots must be members of lab-slots)"
  if [[ ! -s $f ]]; then
    # The secret is shown only once: without the file the token is recreated.
    pveum user token remove lab-manager@pve manager 2>/dev/null || true
    pveum user token add lab-manager@pve manager --privsep 1 --output-format json |
      python3 -c 'import json, sys; print(json.load(sys.stdin)["value"])' >"$f.tmp"
    mv "$f.tmp" "$f"
  fi
  # A privilege-separated token gets the intersection of its own and its user's rights: grant both.
  pveum acl modify /pool/lab-slots -user lab-manager@pve -role LabManager
  pveum acl modify /nodes -user lab-manager@pve -role LabManagerNodes
  pveum acl modify /pool/lab-slots -token "$tid" -role LabManager
  pveum acl modify /nodes -token "$tid" -role LabManagerNodes
}

render_manager_env() {
  local f=$S/manager/manager.env
  {
    echo "# Generated by install/lab-provision from $CONF; local additions: manager.env.local"
    cat <<EOF
DATABASE_URL=postgresql:///lab_manager
MANAGER_SITES_FILE=/etc/lab-manager/sites.json
MANAGER_SLOTS_FILE=/etc/lab-manager/slots.json
MANAGER_LISTEN_HOST=127.0.0.1
MANAGER_LISTEN_PORT=8090
SLOT_SCHEME=https
SLOT_CA_FILE=/etc/lab-manager/slot-server-ca.crt
ALLOW_PLAINTEXT_SLOTS=0
LABS_DIR=/srv/gns3-ro/labs
PVE_NODES=$(for n in "${NODE_NAMES[@]}"; do echo "$n:8006"; done | paste -sd,)
PVE_TOKEN_ID=lab-manager@pve!manager
PVE_TOKEN_SECRET=$(cat "$S/manager/pve-token-secret")
PVE_CA_FILE=/etc/lab-manager/pve-root-ca.pem
AGENT_URL_TEMPLATE=https://{node}.$AGENT_DOMAIN:8443
AGENT_CA_FILE=/etc/lab-manager/node-server-ca.crt
AGENT_CERT_FILE=/etc/lab-manager/manager.crt
AGENT_KEY_FILE=/etc/lab-manager/manager.key
LAB_CEPH_ROOT=$CEPH_ROOT
LAB_CODE_DIR=$CODE_DIR
LAB_STUDENTS_DIR=$STUDENTS_DIR
AGENT_START_ACTIONS=init_slot
SLOT_CODE_REVISION=
PLACEHOLDER_STUDENT_KEY=placeholder
GATEWAY_INTERNAL_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_KEY=$(cat "$S/manager/gateway-key")
GATEWAY_PUBLIC_URL=wss://$PUBLIC_NAME
EOF
    [[ -z ${NODE_GUEST_MEMORY_MB:-} ]] || echo "NODE_GUEST_MEMORY_MB=$NODE_GUEST_MEMORY_MB"
    [[ -z ${NODE_CPU_OVERCOMMIT:-} ]] || echo "NODE_CPU_OVERCOMMIT=$NODE_CPU_OVERCOMMIT"
    [[ ! -s $S/manager/images.json ]] || echo "IMAGES_FILE=/etc/lab-manager/images.json"
    [[ ! -s $S/manager/manager.env.local ]] || cat "$S/manager/manager.env.local"
  } >"$f.tmp"
  mv "$f.tmp" "$f"
}

render_json() {  # sites.json and slots.json; JSON is written by Python, never by string splicing
  local pairs=() id
  for id in "${SLOT_IDS[@]}"; do pairs+=("$id=$(ct_ip "$id")"); done
  SLOT_FEATURES=${INET_BRIDGE:+uplink} python3 - "$S" "$MOODLE_URL" "$SITE_SLUG" "${pairs[@]}" <<'PY'
import json, os, sys
s, url, slug, *pairs = sys.argv[1:]
read = lambda *p: open(os.path.join(s, *p)).read().strip()
def write(name, data):
    path = os.path.join(s, "manager", name)
    with open(path + ".tmp", "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.replace(path + ".tmp", path)
write("sites.json", [{"url": url, "slug": slug, "secret": read("manager", "site-secret")}])
write("slots.json", [{"vmid": int(vmid), "address": ip, "port": 8080,
                      "api_token": read("slots", vmid, "api-token"),
                      "console_token": read("slots", vmid, "console-token"),
                      # The manager sends labs with an "Internet" node only to such slots (CONTRACTS 7)
                      **({"features": os.environ["SLOT_FEATURES"].split()} if os.environ.get("SLOT_FEATURES") else {})}
                     for vmid, ip in (p.split("=", 1) for p in pairs)])
PY
}

render_slot_env() {  # From the slot's own example, so new settings keep their defaults
  local id=$1 f=$S/slots/$1/slot.env
  sed -e "s|^SLOT_API_TOKEN=.*|SLOT_API_TOKEN=$(cat "$S/slots/$id/api-token")|" \
      -e "s|^SLOT_CONSOLE_TOKEN=.*|SLOT_CONSOLE_TOKEN=$(cat "$S/slots/$id/console-token")|" \
      -e "s|^SLOT_LISTEN_HOST=.*|SLOT_LISTEN_HOST=$(ct_ip "$id")|" \
      "$REPO_DIR/slot/slot.env.example" >"$f.tmp"
  grep -q "^SLOT_LISTEN_HOST=$(ct_ip "$id")\$" "$f.tmp" || die "slot.env.example has no SLOT_LISTEN_HOST"
  if inet_on; then  # The MAC of the "Internet" node's outer port: from the VMID, so it is the same on every run
    sed -i "s|^SLOT_UPLINK_MAC=.*|SLOT_UPLINK_MAC=$(uplink_mac "$id")|" "$f.tmp"
    grep -q "^SLOT_UPLINK_MAC=" "$f.tmp" || die "slot.env.example has no SLOT_UPLINK_MAC"
  fi
  mv "$f.tmp" "$f"
}

node_cert() {  # node_cert <node>: the agent's server certificate in $S/nodes/<node>
  local d=$S/nodes/$1 fqdn=$1.$AGENT_DOMAIN ip=${NODE_IPS[$1]}
  install -d -m 0700 "$d"
  issue node-server-ca "$d" server "$fqdn" "basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature,keyEncipherment
extendedKeyUsage=serverAuth
subjectAltName=DNS:$fqdn,IP:$ip"
  san_has "$d/server.crt" "DNS:$fqdn"
  san_has "$d/server.crt" "IP Address:$ip"
  cp "$S/ca/manager-client-ca.crt" "$d/manager-ca.crt"
}

slot_cert() {
  local id=$1 ip
  ip=$(ct_ip "$id")
  issue slot-server-ca "$S/slots/$id" server "slot-$id" "basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature,keyEncipherment
extendedKeyUsage=serverAuth
subjectAltName=IP:$ip"
  san_has "$S/slots/$id/server.crt" "IP Address:$ip"
}

cmd_secrets() {
  [[ -f $REPO_DIR/slot/slot.env.example ]] || die "REPO_DIR $REPO_DIR is not a checkout of the repository"
  local id n
  install -d -m 0700 "$S" "$S/ca" "$S/nodes" "$S/manager" "$S/manager/nginx" "$S/slots" "$S/moodle"
  make_ca manager-client-ca
  make_ca node-server-ca
  make_ca web-ca
  make_ca slot-server-ca
  cp "$S/ca/slot-server-ca.crt" "$S/manager/slot-server-ca.crt"

  for n in "${NODE_NAMES[@]}"; do node_cert "$n"; done

  issue manager-client-ca "$S/manager" manager lab-manager "basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature
extendedKeyUsage=clientAuth"
  cp "$S/ca/node-server-ca.crt" "$S/manager/node-server-ca.crt"
  cp /etc/pve/pve-root-ca.pem "$S/manager/pve-root-ca.pem"

  issue web-ca "$S/manager/nginx" gw "$PUBLIC_NAME" "basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature,keyEncipherment
extendedKeyUsage=serverAuth
subjectAltName=DNS:$PUBLIC_NAME"
  san_has "$S/manager/nginx/gw.crt" "DNS:$PUBLIC_NAME"
  cp "$S/ca/web-ca.crt" "$S/moodle/web-ca.crt"

  rand_into "$S/manager/site-secret"
  rand_into "$S/manager/gateway-key"
  for id in "${SLOT_IDS[@]}"; do
    install -d -m 0700 "$S/slots/$id"
    rand_into "$S/slots/$id/api-token"
    rand_into "$S/slots/$id/console-token"
    slot_cert "$id"
    render_slot_env "$id"
  done
  pve_token
  render_manager_env
  render_json
  chmod -R go-rwx "$S"
  log "secrets ready in $S"
  warn "test mode: the CA keys are in $S/ca; before production move them offline and re-issue everything"
}

need_secrets() { [[ -s $S/manager/manager.env ]] || die "run 'lab-provision secrets' first"; }

# ------------------------------------------------------------------ venv

VENV_SCRIPT='
export DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1
dpkg -s python3.12-venv >/dev/null 2>&1 || { apt-get update -qq; apt-get install -y -qq python3.12-venv; }
cd "$CODE"
python3.12 -m venv --clear venv
venv/bin/python -m pip install -q --disable-pip-version-check $REQS
venv/bin/python -m pip check
'

venv_abort() {  # venv_abort <vmid> <name> <code dir in CT> <host code dir>: a failed build leaves nothing writable
  local id=$1 name=$2 dst=$3 src=$4
  warn "venv build failed: stopping CT $id and taking the writable mount away; fix the cause and repeat the step"
  ct_down "$id" || true
  mp_drop "$id" "$dst/venv" || true
  [[ $name == manager ]] || mp_drop "$id" "$dst" || true  # The agent mounts the slot code itself
  chown -R root:root "$src/venv" || true
}

cmd_venv() {
  local id name src dst reqs
  case ${1:-} in
    slot) id=${LOCAL_SLOTS[0]:-} name=slot dst=/srv/gns3-ro/slot reqs="-r requirements.txt"
          [[ -n $id ]] || die "no slot of SLOTS on this node ($NODE): run on a node with slots" ;;
    manager) id=$MANAGER_VMID name=manager dst=/srv/gns3-ro/manager
             reqs="-r requirements.txt -r gateway/requirements.txt" ;;
    *) die "usage: lab-provision venv slot|manager" ;;
  esac
  src=$REPO_DIR/$name
  [[ -f $src/requirements.txt ]] || die "$src is not the $name code"
  ct_checked "$id"
  if [[ $name == slot ]]; then
    [[ $(ct_state "$id") == stopped ]] || die "slot $id must be stopped (it builds the slot venv)"
  fi
  log "venv for $name, built in CT $id at $dst/venv"
  # The CT's root may write only into venv/, and only while it is built.
  # shellcheck disable=SC2064  # expanded now on purpose: the locals are gone when the trap fires
  trap "$(printf 'venv_abort %q %q %q %q' "$id" "$name" "$dst" "$src")" EXIT
  install -d -m 0755 "$src/venv"
  chown -R "$ID_OFFSET:$ID_OFFSET" "$src/venv"
  ct_down "$id"
  if [[ $name == manager ]]; then manager_mounts; else mp_set "$id" "$src" "$dst" 1; fi
  mp_set "$id" "$src/venv" "$dst/venv" 0 2  # Never mp0/mp1: the agent owns them on slots
  ct_up "$id"
  ct_push "$id" "$REPO_DIR/constraints-tested.txt" /tmp/lab-constraints.txt 0644 0 0
  ct_sh "$id" "$VENV_SCRIPT" CODE="$dst" REQS="$reqs -c /tmp/lab-constraints.txt"
  if [[ $name == slot ]]; then
    ct_sh "$id" 'runuser -u gns3 -- /srv/gns3-ro/slot/venv/bin/python /srv/gns3-ro/slot/release.py check'
  fi
  ct_down "$id"
  mp_drop "$id" "$dst/venv"
  [[ $name == manager ]] || mp_drop "$id" "$dst"  # The agent mounts the slot code itself
  chown -R root:root "$src/venv"
  chmod -R u+rwX,go+rX,go-w "$src/venv"
  [[ $name == slot ]] || ct_up "$id"
  trap - EXIT
  log "venv $src/venv ready"
}

# ------------------------------------------------------------------ slot

SLOT_SCRIPT='
systemctl daemon-reload
. /etc/os-release
[ "$VERSION_ID" = 24.04 ] || echo "WARNING: Ubuntu $VERSION_ID, Lab Slot expects 24.04"
python3 -c "import sys; sys.exit(sys.version_info[:2] != (3, 12))" || echo "WARNING: python3 is not 3.12"
for p in /opt/gns3/images/QEMU /opt/gns3/images/IOU /opt/gns3/qga /dev/kvm /dev/net/tun; do
  [ -e "$p" ] || echo "WARNING: $p is missing"
done
systemctl is-enabled gns3.service >/dev/null 2>&1 || echo "WARNING: gns3.service is not enabled"
if grep -qs "^iourc_path = /opt/gns3/iourc" /etc/gns3/gns3_server.conf && [ ! -s /opt/gns3/iourc ]; then
  echo "WARNING: no /opt/gns3/iourc: IOU devices need the license file (secrets/slot/iourc, then repeat slot)"
fi
v=""
for _ in $(seq 1 30); do
  v=$(python3 -c "import urllib.request; print(urllib.request.urlopen(\"http://127.0.0.1:3080/v2/version\", timeout=2).read().decode())" 2>/dev/null) && break
  sleep 2
done
case $v in *2.2.61*) echo "GNS3: $v" ;; *) echo "WARNING: GNS3 2.2.61 does not answer on 127.0.0.1:3080 ($v)" ;; esac
[ "$(id -u gns3)" != 0 ] || { echo "ERROR: gns3 must not be root"; exit 1; }
echo "gns3-ids $(id -u gns3):$(id -g gns3)"
'

drop_agent_mounts() {  # The agent sets its mount points on every start: they never belong in a slot's saved state
  local id=$1 i
  for i in 0 1; do
    if pct config "$id" | grep -q "^mp$i:"; then
      pct config "$id" | grep -qE "^mp$i: .*mp=(/srv/gns3-ro/slot|/opt/gns3/projects)(,|\$)" ||
        die "slot $id: mp$i is used for something else, but the agent owns mp0 and mp1 (move it to mp2+)"
      pct set "$id" --delete "mp$i"
    fi
  done
  # With IMAGES_DIR mp2 (the images) is the agent's as well: it puts it back with mp0 and mp1.
  if [[ -n $IMAGES_DIR ]] && pct config "$id" | grep -qE '^mp2: .*mp=/opt/gns3/images(,|$)'; then
    pct set "$id" --delete mp2
  fi
}

# The clean state of a slot: the template plus the slot's own identity. The agent rolls the stopped slot
# back to it after every session ('reset'), so nothing a student did in the guest reaches the next one.
# A rollback also restores the CT config: take it again after any change of the slot CT, 'slot' does.
snapshot_slot() {  # snapshot_slot <vmid>: replaces the previous snapshot; the CT is stopped
  local id=$1
  [[ $(ct_state "$id") == stopped ]] || die "slot $id must be stopped for its snapshot"
  drop_agent_mounts "$id"  # a student's directory must never come back with a rollback
  # Proxmox refuses to snapshot a CT that has a bind mount ("snapshot feature is not available").
  local binds
  binds=$(pct config "$id" | grep -E '^mp[0-9]+: /' | cut -d: -f1 | paste -sd, -) || true
  [[ -z $binds ]] ||
    die "slot $id has bind mounts ($binds) and Proxmox cannot snapshot such a CT: only the agent's mp0, mp1 and mp2 are removed"
  if pct config "$id" --snapshot "$CLEAN_SNAPSHOT" >/dev/null 2>&1; then
    pct delsnapshot "$id" "$CLEAN_SNAPSHOT"
  fi
  log "slot $id: snapshot $CLEAN_SNAPSHOT"
  pct snapshot "$id" "$CLEAN_SNAPSHOT" --description "Clean slot: template and its own identity. Created by install/lab-provision."
}

cmd_slot() {
  need_secrets
  local ids=("$@") id tags out
  ((${#ids[@]})) || ids=("${LOCAL_SLOTS[@]}")
  ((${#ids[@]})) || die "no slot of SLOTS on this node ($NODE)"
  for id in "${ids[@]}"; do
    [[ " ${SLOT_IDS[*]} " == *" $id "* ]] || die "$id is not in SLOTS of $CONF"
    ct_checked "$id"
    [[ $(ct_state "$id") == stopped ]] ||
      die "slot $id is running: put it into maintenance in the manager and shut it down first"
    log "slot $id"
    tags=$(pct config "$id" | sed -n 's/^tags: //p')
    [[ ";$tags;" == *";labslot;"* ]] || pct set "$id" --tags "${tags:+$tags;}labslot"
    pct set "$id" --onboot 0
    drop_agent_mounts "$id"  # so the CT boots without them now
    # With IMAGES_DIR the agent also owns mp2 (images); set it now, so the checks below see the images.
    if [[ -n $IMAGES_DIR ]]; then
      ! pct config "$id" | grep -q '^mp2:' || pct config "$id" | grep -qE '^mp2: .*mp=/opt/gns3/images(,|$)' ||
        die "slot $id: mp2 is used for something else, but with IMAGES_DIR the agent owns it (move it to mp3+)"
      pct set "$id" -mp2 "$CEPH_ROOT/$IMAGES_DIR,mp=/opt/gns3/images,ro=1,shared=1"
    fi
    ct_up "$id"
    ct_sh "$id" 'install -d -m 0700 /etc/lab-slot; install -d -m 0755 /usr/local/sbin'
    ct_sh "$id" 'chgrp gns3 /etc/lab-slot; chmod 0750 /etc/lab-slot; install -d -m 0750 -g gns3 /etc/lab-slot/tls'
    slot_cert "$id"
    local slot_gid
    slot_gid=$(ct_sh "$id" 'id -g gns3')
    ct_push "$id" "$S/slots/$id/server.crt" /etc/lab-slot/tls/server.crt 0644 0 0
    ct_push "$id" "$S/slots/$id/server.key" /etc/lab-slot/tls/server.key 0640 0 "$slot_gid"
    if [[ -s $S/slot/iourc ]]; then  # IOU license, the same for every slot
      ct_push "$id" "$S/slot/iourc" /opt/gns3/iourc 0600 "$(ct_sh "$id" 'id -u gns3')" "$slot_gid"
    fi
    render_slot_env "$id"  # The CT's current net0 IP, not the one it had at 'secrets' (e.g. a fresh clone)
    ct_push "$id" "$S/slots/$id/slot.env" /etc/lab-slot/slot.env 0600 0 0
    ct_push "$id" "$REPO_DIR/agent/guest/lab-slot-init" /usr/local/sbin/lab-slot-init 0755 0 0
    ct_push "$id" "$REPO_DIR/slot/lab-slot.service" /etc/systemd/system/lab-slot.service 0644 0 0
    out=$(ct_sh "$id" "$SLOT_SCRIPT")
    grep -v '^gns3-ids ' <<<"$out" || true
    grep '^gns3-ids ' <<<"$out" | cut -d' ' -f2 >"$S/slots/$id/gns3-ids"
    [[ -s $S/slots/$id/gns3-ids ]] || die "slot $id: cannot read the gns3 uid/gid"
    ct_down "$id"
    snapshot_slot "$id"
    log "slot $id ready ($(ct_ip "$id"), gns3 $(cat "$S/slots/$id/gns3-ids"))"
  done
}

cmd_snapshot() {
  local ids=("$@") id
  ((${#ids[@]})) || ids=("${LOCAL_SLOTS[@]}")
  ((${#ids[@]})) || die "no slot of SLOTS on this node ($NODE)"
  for id in "${ids[@]}"; do
    [[ " ${SLOT_IDS[*]} " == *" $id "* ]] || die "$id is not in SLOTS of $CONF"
    ct_checked "$id"
    [[ $(ct_state "$id") == stopped ]] ||
      die "slot $id is running: put it into maintenance in the manager and shut it down first"
    # The snapshot must hold the identity that 'slot' pushes (tokens, TLS, IP), not a bare clone.
    [[ -s $S/slots/$id/gns3-ids ]] || die "slot $id: run 'lab-provision slot $id' first"
    snapshot_slot "$id"
  done
}

# ------------------------------------------------------------------ agent

ceph_dirs() {  # ceph_dirs <path below CEPH_ROOT>: missing directories, root 0755 each
  local path=$CEPH_ROOT p rel
  IFS=/ read -ra rel <<<"$1"
  for p in "${rel[@]}"; do
    path=$path/$p
    [[ -d $path ]] || install -d -o root -g root -m 0755 "$path"
  done
}

cmd_agent() {
  need_secrets
  need_node
  local d=$S/nodes/$NODE ids id f uid gid p path vmid_min vmid_max
  [[ -s $d/server.key ]] || die "no certificate for node $NODE: run secrets after adding it to NODES"
  ((${#LOCAL_SLOTS[@]})) || die "no slot of SLOTS on this node ($NODE)"
  read -r vmid_min vmid_max < <(node_range "$NODE")
  ids=$(cat "$S/slots/${LOCAL_SLOTS[0]}/gns3-ids" 2>/dev/null) ||
    die "run 'lab-provision slot' on this node first (gns3 uid/gid)"
  for id in "${LOCAL_SLOTS[@]}"; do
    [[ $(cat "$S/slots/$id/gns3-ids" 2>/dev/null) == "$ids" ]] ||
      die "slot $id: gns3 uid/gid differs from slot ${LOCAL_SLOTS[0]} or is unknown (run slot $id)"
  done
  # Student directories are shared by all nodes, so every slot must map gns3 the same way.
  for id in "${SLOT_IDS[@]}"; do
    f=$S/slots/$id/gns3-ids
    [[ ! -s $f || $(cat "$f") == "$ids" ]] ||
      die "slot $id on ${SLOT_NODE[$id]} has gns3 $(cat "$f"), the slots here $ids: they share student directories"
  done
  uid=$((${ids%:*} + ID_OFFSET)) gid=$((${ids#*:} + ID_OFFSET))

  log "CephFS layout"
  case $(findmnt --mountpoint "$CEPH_ROOT" -n -o FSTYPE) in
    ceph | fuse.ceph | fuse.ceph-fuse) ;;
    *) die "$CEPH_ROOT is not a CephFS mount point" ;;
  esac
  [[ -f $CEPH_ROOT/$CODE_DIR/run.py ]] || die "no slot code at $CEPH_ROOT/$CODE_DIR"
  ceph_dirs "$STUDENTS_DIR/placeholder"
  if [[ -n $IMAGES_DIR ]]; then
    ceph_dirs "$IMAGES_DIR/QEMU"
    ceph_dirs "$IMAGES_DIR/IOU"
    [[ -n $(find "$CEPH_ROOT/$IMAGES_DIR" -type f -print -quit) ]] ||
      warn "$CEPH_ROOT/$IMAGES_DIR has no images yet (QEMU/, IOU/ as in /opt/gns3/images of a slot)"
  fi
  # The agent refuses mounts below non-root or group/other-writable ancestors.
  local checked=() up=$CEPH_ROOT
  while [[ $up != / ]]; do checked+=("$up"); up=$(dirname "$up"); done
  checked+=("$REPO_DIR" "$CEPH_ROOT/$CODE_DIR" "$CEPH_ROOT/$STUDENTS_DIR")
  if [[ -n $IMAGES_DIR ]]; then
    path=$CEPH_ROOT/$IMAGES_DIR
    while [[ $path != "$CEPH_ROOT" ]]; do checked+=("$path"); path=$(dirname "$path"); done
  fi
  path=$CEPH_ROOT/$STUDENTS_DIR
  while [[ $path != "$CEPH_ROOT" ]]; do checked+=("$path"); path=$(dirname "$path"); done
  for p in "${checked[@]}"; do
    [[ $(stat -c '%u' "$p") == 0 && $(( 0$(stat -c '%a' "$p") & 022 )) == 0 ]] ||
      die "$p must be owned by root and not writable by group/others ($(stat -c '%U:%G %a' "$p"))"
  done

  log "agent certificates and settings"
  install -d -m 0700 /etc/lab-node-agent
  install -m 0600 "$d/server.key" /etc/lab-node-agent/server.key
  install -m 0644 "$d/server.crt" /etc/lab-node-agent/server.crt
  install -m 0644 "$d/manager-ca.crt" /etc/lab-node-agent/manager-ca.crt
  install -d -m 0755 /etc/systemd/system/lab-node-agent.service.d
  cat >/etc/systemd/system/lab-node-agent.service.d/override.conf <<EOF
# Generated by install/lab-provision
[Service]
Environment=LAB_CEPH_ROOT=$CEPH_ROOT
Environment=LAB_CODE_DIR=$CODE_DIR
Environment=LAB_STUDENTS_DIR=$STUDENTS_DIR
Environment=LAB_IMAGES_DIR=$IMAGES_DIR
Environment=LAB_CLEAN_SNAPSHOT=$CLEAN_SNAPSHOT
Environment=LAB_VMID_MIN=$vmid_min
Environment=LAB_VMID_MAX=$vmid_max
Environment=LAB_STUDENT_HOST_UID=$uid
Environment=LAB_STUDENT_HOST_GID=$gid
EOF
  chmod 0644 /etc/systemd/system/lab-node-agent.service.d/override.conf
  log "agent install (agent/install-node.sh)"
  (cd "$REPO_DIR/agent" && umask 022 && ./install-node.sh)
  sleep 2
  agent_check
  log "firewall: allow TCP 8443 only from the manager, e.g.:"
  echo "  iptables -I INPUT -p tcp --dport 8443 -j DROP"
  echo "  iptables -I INPUT -p tcp --dport 8443 -s $(ct_ip "$MANAGER_VMID") -j ACCEPT"
  echo "  iptables -I INPUT -i lo -p tcp --dport 8443 -j ACCEPT"
}

agent_curl() {  # mTLS with the manager's certificate, to this node's agent via loopback
  curl -sS --max-time 15 --noproxy '*' --resolve "$NODE_FQDN:8443:127.0.0.1" --cert "$S/manager/manager.crt" \
    --key "$S/manager/manager.key" --cacert "$S/manager/node-server-ca.crt" "$@"
}

agent_check() {
  local id
  log "agent https://$NODE_FQDN:8443"
  echo "health: $(agent_curl "https://$NODE_FQDN:8443/health" 2>&1 || echo ' FAILED')"
  for id in "${LOCAL_SLOTS[@]}"; do
    echo "slot $id: $(agent_curl "https://$NODE_FQDN:8443/slots/$id/status" 2>&1 || echo ' FAILED')"
    if pct config "$id" --snapshot "$CLEAN_SNAPSHOT" >/dev/null 2>&1; then
      echo "slot $id snapshot $CLEAN_SNAPSHOT: present"
    else
      echo "slot $id snapshot $CLEAN_SNAPSHOT: MISSING, the agent cannot reset it (run 'lab-provision snapshot $id')"
    fi
  done
}

# ------------------------------------------------------------------ manager

manager_mounts() {  # Code and labs, read-only. The CT must be stopped when they change.
  local id=$MANAGER_VMID
  if ! mp_ok "$id" "$REPO_DIR/manager" /srv/gns3-ro/manager 1 || ! mp_ok "$id" "$REPO_DIR/labs" /srv/gns3-ro/labs 1; then
    ct_down "$id"
    mp_set "$id" "$REPO_DIR/manager" /srv/gns3-ro/manager 1
    mp_set "$id" "$REPO_DIR/labs" /srv/gns3-ro/labs 1
  fi
}

MANAGER_PREPARE='
export DEBIAN_FRONTEND=noninteractive
missing=""
for p in postgresql nginx curl python3.12; do dpkg -s "$p" >/dev/null 2>&1 || missing="$missing $p"; done
[ -z "$missing" ] || { apt-get update -qq; apt-get install -y -qq $missing; }
id lab-manager >/dev/null 2>&1 || useradd --system --home-dir /nonexistent --shell /usr/sbin/nologin lab-manager
systemctl enable --now postgresql >/dev/null
runuser -u postgres -- psql -tAc "SELECT 1 FROM pg_roles WHERE rolname = '"'"'lab-manager'"'"'" | grep -q 1 ||
  runuser -u postgres -- createuser lab-manager
runuser -u postgres -- psql -tAc "SELECT 1 FROM pg_database WHERE datname = '"'"'lab_manager'"'"'" | grep -q 1 ||
  runuser -u postgres -- createdb -O lab-manager lab_manager
printf "%s\n" "$HOSTS" | while read -r ip fqdn name; do
  if ! grep -qF " $fqdn " /etc/hosts; then echo "$ip $fqdn $name" >>/etc/hosts
  elif ! grep -qxF "$ip $fqdn $name" /etc/hosts; then echo "WARNING: /etc/hosts has another entry for $fqdn (expected $ip)"
  fi
done
install -d -o root -g lab-manager -m 0750 /etc/lab-manager
install -d -m 0750 /etc/nginx/ssl
echo "ids $(id -u lab-manager) $(id -g lab-manager)"
'

MANAGER_START='
ADM="runuser -u lab-manager -- /srv/gns3-ro/manager/lab-manager-admin"
$ADM migrate
$ADM check-config
$ADM gateway-env | install -m 0600 /dev/stdin /etc/lab-manager/gateway.env
cp /srv/gns3-ro/manager/lab-manager.service /srv/gns3-ro/manager/gateway/lab-console-gateway.service /etc/systemd/system/
systemctl daemon-reload
systemctl enable lab-manager lab-console-gateway >/dev/null 2>&1
systemctl restart lab-manager lab-console-gateway
rm -f /etc/nginx/sites-enabled/default
ln -sf /etc/nginx/sites-available/lab.conf /etc/nginx/sites-enabled/lab.conf
nginx -t
systemctl reload-or-restart nginx
for _ in $(seq 1 30); do curl -fsS 127.0.0.1:8090/readyz >/dev/null 2>&1 && break; sleep 2; done
echo "readyz: $(curl -sS 127.0.0.1:8090/readyz)"
'

agent_hosts() {  # "<ip> <fqdn> <node>" of every node: the manager reaches agents and Proxmox by name
  local n
  for n in "${NODE_NAMES[@]}"; do echo "${NODE_IPS[$n]} $n.$AGENT_DOMAIN $n"; done
}

render_nginx() {
  local f=$S/manager/nginx/lab.conf
  {
    cat <<EOF
# Generated by install/lab-provision
server {
    listen 443 ssl;
    server_name $PUBLIC_NAME;
    ssl_certificate     /etc/nginx/ssl/gw.crt;
    ssl_certificate_key /etc/nginx/ssl/gw.key;

    # Moodle server -> manager API
    location /api/ {
        allow $MOODLE_IP;
        deny all;
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host \$host;
        proxy_read_timeout 60s;
    }

    # Browsers -> console gateway (manager/gateway/nginx-console.conf)
EOF
    grep -v '^#' "$REPO_DIR/manager/gateway/nginx-console.conf" | sed 's/^\(.\)/    \1/'
    echo "}"
  } >"$f.tmp"
  mv "$f.tmp" "$f"
}

cmd_manager() {
  need_secrets
  local id=$MANAGER_VMID m=$S/manager out uid gid f
  ct_checked "$id"
  # venv/bin/python links to the CT's /usr/bin/python3.12, which the host may lack: test pyvenv.cfg.
  [[ -f $REPO_DIR/manager/venv/pyvenv.cfg ]] || die "no $REPO_DIR/manager/venv: run 'lab-provision venv manager'"
  if [[ ! -d $REPO_DIR/labs ]]; then
    log "lab catalog $REPO_DIR/labs from manager/examples/labs"
    install -d -m 0755 "$REPO_DIR/labs"
    cp -a "$REPO_DIR/manager/examples/labs/." "$REPO_DIR/labs/"
    chmod -R u+rwX,go+rX,go-w "$REPO_DIR/labs"
  fi
  manager_mounts
  ct_up "$id"
  log "manager CT $id: packages, user, database"
  out=$(ct_sh "$id" "$MANAGER_PREPARE" HOSTS="$(agent_hosts)")
  grep -v '^ids ' <<<"$out" || true
  read -r _ uid gid < <(grep '^ids ' <<<"$out")
  [[ -n ${gid:-} ]] || die "cannot read the lab-manager uid/gid in CT $id"

  log "manager CT $id: secrets and configs"
  render_manager_env  # From lab.conf and the CTs' current IPs, as README promises
  render_json
  ct_push "$id" "$m/manager.env" /etc/lab-manager/manager.env 0640 0 "$gid"
  for f in sites.json slots.json manager.key; do
    ct_push "$id" "$m/$f" "/etc/lab-manager/$f" 0600 "$uid" "$gid"
  done
  for f in manager.crt node-server-ca.crt pve-root-ca.pem slot-server-ca.crt; do
    ct_push "$id" "$m/$f" "/etc/lab-manager/$f" 0644 0 0
  done
  [[ ! -s $m/images.json ]] || ct_push "$id" "$m/images.json" /etc/lab-manager/images.json 0640 0 "$gid"
  render_nginx
  ct_push "$id" "$m/nginx/gw.crt" /etc/nginx/ssl/gw.crt 0644 0 0
  ct_push "$id" "$m/nginx/gw.key" /etc/nginx/ssl/gw.key 0600 0 0
  ct_push "$id" "$m/nginx/lab.conf" /etc/nginx/sites-available/lab.conf 0644 0 0

  log "manager CT $id: migrate, gateway-env, services"
  ct_sh "$id" "$MANAGER_START"
}

# ------------------------------------------------------------------ moodle

MOODLE_SCRIPT='
update-ca-certificates >/dev/null
getent hosts "$PUBLIC_NAME" >/dev/null || echo "$MANAGER_IP $PUBLIC_NAME" >>/etc/hosts
code=$(curl -sS --noproxy "*" -o /dev/null -w "%{http_code}" -H "Authorization: Bearer $SECRET" -H "X-Moodle-Site: $MOODLE_URL" \
  "https://$PUBLIC_NAME/api/v1/info") || code="TLS or network error"
echo "Moodle -> https://$PUBLIC_NAME/api/v1/info: $code (expected 200)"
'

cmd_moodle() {
  need_secrets
  local secret mgr_ip
  secret=$(cat "$S/manager/site-secret")
  mgr_ip=$(ct_ip "$MANAGER_VMID")
  if [[ -n ${MOODLE_VMID:-} ]]; then
    ct_local "$MOODLE_VMID"
    [[ $(ct_state "$MOODLE_VMID") == running ]] || die "Moodle CT $MOODLE_VMID is not running"
    log "Moodle CT $MOODLE_VMID: web CA into the system trust store"
    ct_push "$MOODLE_VMID" "$S/moodle/web-ca.crt" /usr/local/share/ca-certificates/lab-web-ca.crt 0644 0 0
    ct_sh "$MOODLE_VMID" "$MOODLE_SCRIPT" PUBLIC_NAME="$PUBLIC_NAME" MANAGER_IP="$mgr_ip" \
      SECRET="$secret" MOODLE_URL="$MOODLE_URL"
  else
    log "Moodle is not an LXC here: copy $S/moodle/web-ca.crt to its /usr/local/share/ca-certificates/"
    echo "  and run update-ca-certificates; $PUBLIC_NAME must resolve to $mgr_ip there"
  fi
  cat >"$S/moodle/plugin.txt" <<EOF
Manager URL:  https://$PUBLIC_NAME
Site secret:  $secret
Site address: $MOODLE_URL (must equal \$CFG->wwwroot)
EOF
  log "plugin settings ($S/moodle/plugin.txt):"
  cat "$S/moodle/plugin.txt"
  warn "browsers open wss://$PUBLIC_NAME/console/: they must trust $S/moodle/web-ca.crt too"
}

# ------------------------------------------------------------------ check, enable

MANAGER_CHECK='
. /etc/lab-manager/manager.env
agent() { curl -sS --max-time 15 --noproxy "*" --cert "$AGENT_CERT_FILE" --key "$AGENT_KEY_FILE" --cacert "$AGENT_CA_FILE" "https://$1:8443$2" 2>&1 || echo " FAILED"; }
echo "readyz: $(curl -sS 127.0.0.1:8090/readyz)"
for a in $AGENTS; do echo "agent $a: $(agent "$a" /health)"; done
for p in $SLOT_AGENTS; do echo "slot ${p%%=*} via ${p#*=}: $(agent "${p#*=}" "/slots/${p%%=*}/status")"; done
for n in $(echo "$PVE_NODES" | tr , " "); do
  echo "proxmox $n: $(curl -sS -o /dev/null -w "%{http_code}" --cacert "$PVE_CA_FILE" -H "Authorization: PVEAPIToken=$PVE_TOKEN_ID=$PVE_TOKEN_SECRET" "https://$n/api2/json/cluster/resources?type=vm") (expected 200)"
done
echo "services: $(systemctl is-active lab-manager lab-console-gateway nginx | paste -sd " ")"
runuser -u lab-manager -- /srv/gns3-ro/manager/lab-manager-admin slots
runuser -u lab-manager -- /srv/gns3-ro/manager/lab-manager-admin check || echo "admin check failed (a manager older than 0.11.1 has no such command)"
'

cmd_check() {
  need_secrets
  local n id agents=() slot_agents=()
  [[ ${#LOCAL_SLOTS[@]} -gt 0 || $MANAGER_NODE == "$NODE" ]] ||
    die "neither slots nor the manager are on this node ($NODE)"
  ((${#LOCAL_SLOTS[@]} == 0)) || { need_node; agent_check; }
  if [[ $MANAGER_NODE != "$NODE" ]]; then
    log "manager CT $MANAGER_VMID is on $MANAGER_NODE: run check there for the manager and all agents"
    return 0
  fi
  for n in "${NODE_NAMES[@]}"; do agents+=("$n.$AGENT_DOMAIN"); done
  for id in "${SLOT_IDS[@]}"; do slot_agents+=("$id=${SLOT_NODE[$id]}.$AGENT_DOMAIN"); done
  log "manager CT $MANAGER_VMID"
  ct_sh "$MANAGER_VMID" "$MANAGER_CHECK" AGENTS="${agents[*]}" SLOT_AGENTS="${slot_agents[*]}"
}

cmd_slot_state() {  # Internal, on the manager's node: the state of a slot in the manager, or "unknown"
  ct_local "$MANAGER_VMID"
  # shellcheck disable=SC2016  # expands inside the CT
  pct exec "$MANAGER_VMID" -- runuser -u lab-manager -- /srv/gns3-ro/manager/lab-manager-admin slots 2>/dev/null |
    python3 -c '
import json, sys
state = "unknown"
for line in sys.stdin:
    try:
        row = json.loads(line)
    except ValueError:
        continue
    if str(row.get("vmid")) == sys.argv[1]:
        state = str(row.get("state"))
print(state)' "$1" || echo unknown
}

cmd_reconcile() {  # On the node of the slot: the agent's uncertain mark, by lab-reconcile.py (checks first)
  local id=${1:-} yes=() ct_state manager_state
  [[ $id =~ ^[0-9]+$ ]] || die "usage: lab-provision reconcile <VMID> [--yes]"
  shift
  case ${1:-} in --yes) yes=(--yes) ;; "") ;; *) die "unknown argument: $1" ;; esac
  [[ " ${SLOT_IDS[*]} " == *" $id "* ]] || die "$id is not in SLOTS of $CONF"
  ct_local "$id"
  need_cluster  # SELF: the same script reads the slot state on the manager's node
  ct_state=$(pct status "$id" | awk '{print $2}')
  if [[ $MANAGER_NODE == "$NODE" ]]; then
    manager_state=$(cmd_slot_state "$id" | tail -n 1)
  else
    manager_state=$(run_on "$MANAGER_NODE" _slot-state "$id" | tail -n 1) || manager_state=unknown
  fi
  exec /usr/bin/python3 -I -B "${SELF%/*}/lab-reconcile.py" "$id" "${yes[@]}" \
    --ct-state "$ct_state" --manager-state "${manager_state:-unknown}"
}

cmd_enable() {
  local ids=("$@") id
  ((${#ids[@]})) || ids=("${SLOT_IDS[@]}")
  ct_local "$MANAGER_VMID"
  for id in "${ids[@]}"; do
    [[ " ${SLOT_IDS[*]} " == *" $id "* ]] || die "$id is not in SLOTS of $CONF"
    ct_sh "$MANAGER_VMID" 'runuser -u lab-manager -- /srv/gns3-ro/manager/lab-manager-admin slot-enable "$VMID"' VMID="$id"
  done
}

# ------------------------------------------------------------------ create: template, manager and slot CTs

need_create_conf() {
  local v
  for v in CT_STORAGE CT_BRIDGE CT_CIDR; do
    [[ -n ${!v:-} ]] || die "$v is not set in $CONF (needed to create CTs)"
  done
  [[ $CT_CIDR =~ ^[0-9]{1,2}$ ]] || die "CT_CIDR is a prefix length, e.g. 24"
}

net0() {  # net0 <ip|dhcp>: the network line of a CT the script creates
  local ip=$1
  [[ $ip == dhcp ]] || ip=$ip/$CT_CIDR${CT_GATEWAY:+,gw=$CT_GATEWAY}
  echo "name=eth0,bridge=$CT_BRIDGE,ip=$ip${CT_VLAN:+,tag=$CT_VLAN}"
}

inet_on() { [[ -n ${INET_BRIDGE:-} ]]; }

net1() {  # The second NIC of the slots (eth1, no IP): the labs' uplink. No firewall=1: its macfilter would drop the
          # frames of the cloud node, whose MAC is not the hwaddr of net1. The VLAN is guarded by lab-uplink-filter.
  echo "name=eth1,bridge=$INET_BRIDGE,tag=$INET_VLAN,ip=manual"
}

uplink_mac() {  # uplink_mac <vmid>: 02:6c:61 (locally administered unicast) and the VMID in the low three bytes
  [[ $1 =~ ^[0-9]+$ ]] && (($1 < 16777216)) || die "VMID $1 does not fit SLOT_UPLINK_MAC (up to 16777215)"
  printf '02:6c:61:%02x:%02x:%02x\n' $(($1 >> 16 & 255)) $(($1 >> 8 & 255)) $(($1 & 255))
}

CT_DNS=()  # pct create options for DNS, if lab.conf sets them
ct_dns() {
  CT_DNS=()
  [[ -z ${CT_NAMESERVER:-} ]] || CT_DNS+=(--nameserver "$CT_NAMESERVER")
  [[ -z ${CT_SEARCHDOMAIN:-} ]] || CT_DNS+=(--searchdomain "$CT_SEARCHDOMAIN")
}

ostemplate() {  # The Ubuntu 24.04 image for new CTs on this node: CT_OSTEMPLATE, or the newest one
  local vol=${CT_OSTEMPLATE:-} store name
  if [[ -z $vol ]]; then
    pveam update >/dev/null 2>&1 || warn "pveam update failed, using the cached image list"
    name=$(pveam available --section system | awk '{print $2}' | grep '^ubuntu-24\.04-standard_' | sort -V | tail -1)
    [[ -n $name ]] || die "no ubuntu-24.04-standard image in 'pveam available': set CT_OSTEMPLATE"
    vol=local:vztmpl/$name
  fi
  store=${vol%%:*} name=${vol##*/}
  [[ $name == ubuntu-24.04-* ]] || warn "CT_OSTEMPLATE $vol: the manager and the slots expect Ubuntu 24.04"
  if ! pveam list "$store" | awk '{print $1}' | grep -qxF "$vol"; then
    log "downloading $name to $store" >&2
    pveam update >/dev/null 2>&1 || true
    pveam download "$store" "$name" >&2
  fi
  echo "$vol"
}

# Inside the template CT: GNS3 server 2.2.61 (pinned, in its own venv), QEMU/KVM, ubridge, VPCS, IOU
# libraries, user gns3 with a fixed uid/gid, the directories the agent and the slot expect.
TEMPLATE_SCRIPT='
export DEBIAN_FRONTEND=noninteractive
. /etc/os-release
[ "$VERSION_ID" = 24.04 ] || { echo "ERROR: Ubuntu $VERSION_ID, the slot template needs 24.04"; exit 1; }
for _ in $(seq 1 30); do getent hosts archive.ubuntu.com >/dev/null && break; sleep 2; done
apt-get update -qq
apt-get install -y -qq software-properties-common ca-certificates curl openssl libcap2-bin \
  python3.12 python3.12-venv qemu-system-x86 qemu-utils >/dev/null
add-apt-repository -y ppa:gns3/ppa >/dev/null
dpkg --add-architecture i386
apt-get update -qq
apt-get install -y -qq ubridge vpcs dynamips gns3-iou >/dev/null
setcap cap_net_admin,cap_net_raw=ep /usr/bin/ubridge

getent group gns3 >/dev/null || groupadd --gid "$GNS3_ID" gns3
id gns3 >/dev/null 2>&1 ||
  useradd --uid "$GNS3_ID" --gid gns3 --home-dir /var/lib/gns3 --create-home --shell /usr/sbin/nologin gns3
[ "$(id -u gns3):$(id -g gns3)" = "$GNS3_ID:$GNS3_ID" ] ||
  { echo "ERROR: gns3 is $(id -u gns3):$(id -g gns3), expected $GNS3_ID:$GNS3_ID"; exit 1; }
getent group kvm >/dev/null || groupadd --system kvm
usermod -aG kvm gns3

# Mount points of the agent (code, student directory, images) and the local GNS3 directories.
install -d -m 0755 /srv/gns3-ro/slot /opt/gns3 /opt/gns3/projects /opt/gns3/images \
  /opt/gns3/images/QEMU /opt/gns3/images/IOU /etc/gns3
install -d -o gns3 -g gns3 -m 0700 /opt/gns3/qga
install -d -o gns3 -g gns3 -m 0750 /var/lib/gns3/configs /var/lib/gns3/appliances /var/lib/gns3/symbols

python3.12 -m venv --clear /opt/gns3-server
/opt/gns3-server/bin/python -m pip install -q --disable-pip-version-check "gns3-server==$GNS3_VERSION"

cat >/etc/gns3/gns3_server.conf <<EOF
# Generated by install/lab-provision (slot template)
[Server]
host = 127.0.0.1
port = 3080
auth = False
images_path = /opt/gns3/images
projects_path = /opt/gns3/projects
configs_path = /var/lib/gns3/configs
appliances_path = /var/lib/gns3/appliances
symbols_path = /var/lib/gns3/symbols
ubridge_path = /usr/bin/ubridge
report_errors = False

[Qemu]
enable_hardware_acceleration = True
require_hardware_acceleration = True

[IOU]
iourc_path = /opt/gns3/iourc
license_check = True
EOF
cat >/etc/systemd/system/gns3.service <<EOF
# Generated by install/lab-provision (slot template)
[Unit]
Description=GNS3 server $GNS3_VERSION
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=gns3
Group=gns3
ExecStart=/opt/gns3-server/bin/gns3server --config /etc/gns3/gns3_server.conf
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable gns3.service >/dev/null 2>&1
# Slots are reached with pct only; a cloned sshd would share its host keys between all of them.
apt-get purge -y -qq openssh-server >/dev/null 2>&1 || true
apt-get autoremove -y -qq >/dev/null
'

TEMPLATE_VERIFY='
systemctl restart gns3.service
v=""
for _ in $(seq 1 30); do v=$(curl -fsS http://127.0.0.1:3080/v2/version 2>/dev/null) && break; sleep 2; done
case $v in *"$GNS3_VERSION"*) echo "GNS3: $v" ;; *) echo "ERROR: GNS3 $GNS3_VERSION does not answer ($v)"; exit 1 ;; esac
runuser -u gns3 -- test -r /dev/kvm -a -w /dev/kvm || { echo "ERROR: gns3 cannot use /dev/kvm"; exit 1; }
test -c /dev/net/tun || { echo "ERROR: no /dev/net/tun"; exit 1; }
getcap /usr/bin/ubridge | grep -q cap_net_admin || { echo "ERROR: ubridge has no capabilities"; exit 1; }
qemu-system-x86_64 --version | head -1
'

# Clones must not share anything that identifies one machine or one slot.
TEMPLATE_CLEAN='
systemctl stop gns3.service
rm -rf /var/lib/lab-slot /etc/lab-slot /opt/gns3/iourc /var/lib/gns3/.config
find /tmp /var/tmp -mindepth 1 -delete
apt-get clean
truncate -s 0 /etc/machine-id
rm -f /var/lib/dbus/machine-id
journalctl --rotate >/dev/null 2>&1 || true
journalctl --vacuum-time=1s >/dev/null 2>&1 || true
'

have_kvm() { [[ -c /dev/kvm ]]; }

cmd_template() {
  [[ -n $TEMPLATE_VMID ]] || die "SLOT_TEMPLATE is not set in $CONF"
  [[ $TEMPLATE_NODE == "$NODE" ]] || die "the template is planned on $TEMPLATE_NODE: run this step there"
  need_create_conf
  local id=$TEMPLATE_VMID gid vol
  if ct_node "$id" >/dev/null; then
    ct_local "$id"
    if pct config "$id" | grep -q '^template: 1'; then log "slot template $id exists"; return 0; fi
    die "CT $id exists and is not a template (a failed build?): check it, destroy it ('pct destroy $id') and repeat"
  fi
  have_kvm || die "this node has no /dev/kvm: the slots run QEMU with KVM"
  vol=$(ostemplate)
  ct_dns
  local net1_opt=()
  ! inet_on || net1_opt=(--net1 "$(net1)")  # Clones inherit it; the uplink is the same for all slots
  log "slot template $id from $vol"
  pct create "$id" "$vol" --hostname lab-slot-template --unprivileged 1 --features nesting=1 --ostype ubuntu \
    --cores 2 --memory 4096 --swap 0 --rootfs "$CT_STORAGE:${SLOT_DISK_GB:-32}" --net0 "$(net0 "${PLAN_IP[$id]}")" \
    "${net1_opt[@]}" "${CT_DNS[@]}" --onboot 0 --description "Lab slot template, GNS3 $GNS3_VERSION. Created by install/lab-provision."
  ct_up "$id"
  ct_sh "$id" "$TEMPLATE_SCRIPT" GNS3_ID="${SLOT_GNS3_ID:-1500}" GNS3_VERSION="$GNS3_VERSION"
  gid=$(ct_sh "$id" 'getent group kvm | cut -d: -f3')
  ct_down "$id"
  # Unprivileged CTs get host devices by path; /dev/kvm keeps the guest group kvm.
  pct set "$id" -dev0 "/dev/kvm,gid=$gid,mode=0660" -dev1 /dev/net/tun,mode=0666
  ct_up "$id"
  ct_sh "$id" "$TEMPLATE_VERIFY" GNS3_VERSION="$GNS3_VERSION"
  ct_sh "$id" "$TEMPLATE_CLEAN"
  ct_down "$id"
  pct template "$id"
  log "slot template $id ready"
}

cmd_create_manager() {  # On the manager's planned node
  local id=$MANAGER_VMID vol
  need_create_conf
  [[ ${PLAN_NODE[$id]:-} == "$NODE" ]] || die "CREATE_MANAGER plans CT $id on ${PLAN_NODE[$id]:-no node}, this is $NODE"
  if ct_node "$id" >/dev/null; then log "manager CT $id exists"; return 0; fi
  vol=$(ostemplate)
  ct_dns
  log "manager CT $id from $vol"
  pct create "$id" "$vol" --hostname lab-manager --unprivileged 1 --features nesting=1 --ostype ubuntu \
    --cores "${MANAGER_CORES:-2}" --memory "${MANAGER_MEMORY_MB:-4096}" --swap 512 \
    --rootfs "$CT_STORAGE:${MANAGER_DISK_GB:-16}" --net0 "$(net0 "${PLAN_IP[$id]}")" "${CT_DNS[@]}" \
    --onboot 1 --tags labprov --description "Lab manager. Created by install/lab-provision."
}

cmd_clone_slot() {  # On the template's node: a clone (SLOT_CLONE), onto the slot's node if it is another one
  local id=$1 node=${PLAN_NODE[$1]:-} t=$TEMPLATE_VMID
  need_create_conf
  [[ -n $node ]] || die "slot $id is not in CREATE_SLOTS"
  [[ $TEMPLATE_NODE == "$NODE" ]] || die "run on the template's node $TEMPLATE_NODE"
  if ct_node "$id" >/dev/null; then log "slot CT $id exists"; return 0; fi
  pct config "$t" 2>/dev/null | grep -q '^template: 1' || die "slot template $t is missing: run 'lab-provision template'"
  # A template built before INET_BRIDGE was set has no net1: say so instead of cloning slots without an uplink.
  if inet_on && ! pct config "$t" | grep -q '^net1:'; then
    die "slot template $t has no net1 (INET_BRIDGE is set): pct set $t -net1 $(net1)"
  fi
  log "slot CT $id on $node from template $t ($SLOT_CLONE clone)"
  local opts=(--hostname "slot-$id" --description "Lab slot. Created by install/lab-provision.")
  # A linked clone shares the template's disk (a snapshot on RBD): seconds instead of copying all of it.
  # It stays on the template's storage, so there is no --storage, and the template cannot be removed
  # while a clone exists.
  if [[ $SLOT_CLONE == linked ]]; then opts+=(--full 0); else opts+=(--full 1 --storage "$CT_STORAGE"); fi
  # Another node needs the template on shared storage (RBD): pct refuses otherwise.
  [[ $node == "$NODE" ]] || opts+=(--target "$node")
  pct clone "$t" "$id" "${opts[@]}"
  # The config now lives on $node: pvesh reaches it from here. A net0 without hwaddr gets a new MAC.
  # net1 too: a clone may keep the template's MAC, and the MACs must be unique in the shared VLAN.
  local net1_opt=()
  ! inet_on || net1_opt=(--net1 "$(net1)")
  pvesh set "/nodes/$node/lxc/$id/config" --net0 "$(net0 "${PLAN_IP[$id]}")" "${net1_opt[@]}" --onboot 0 --tags 'labslot;labprov'
}

cmd_create() {
  need_cluster
  local id
  if ! ct_node "$MANAGER_VMID" >/dev/null; then
    [[ -n ${PLAN_NODE[$MANAGER_VMID]:-} ]] || die "manager CT $MANAGER_VMID does not exist and CREATE_MANAGER is not set"
    run_on "${PLAN_NODE[$MANAGER_VMID]}" _create-manager
  fi
  for id in "${SLOT_IDS[@]}"; do
    ct_node "$id" >/dev/null && continue
    [[ -n ${PLAN_NODE[$id]:-} ]] || die "slot CT $id does not exist and is not in CREATE_SLOTS"
    [[ -n $TEMPLATE_VMID ]] || die "slot CT $id must be cloned, but SLOT_TEMPLATE is not set"
    run_on "$TEMPLATE_NODE" _clone-slot "$id"
  done
}

# ------------------------------------------------------------------ deploy, reset: the whole cluster

SELF=''  # This script on CephFS, the same path on every node; set by need_cluster

need_cluster() {
  SELF=$REPO_DIR/install/lab-provision
  [[ -x $SELF ]] || die "no $SELF: REPO_DIR must be the checkout every node sees"
  [[ $(readlink -f "$0") == "$(readlink -f "$SELF")" ]] ||
    warn "running $0, the nodes run $SELF: use that one to keep them identical"
  [[ $(readlink -f "$CONF") == "$CEPH_ROOT"/* ]] || die "LAB_CONF $CONF must be on CephFS, the other nodes read it"
}

node_addr() {  # The cluster address of node $1, as corosync knows it
  python3 - "$1" <<'PY'
import json, sys
print(json.load(open("/etc/pve/.members"))["nodelist"][sys.argv[1]]["ip"])
PY
}

# run_on <node> <step> [args]: this script on that node, over the root ssh Proxmox itself uses
run_on() {
  local n=$1 q a
  shift
  log "[$n] lab-provision $*"
  if [[ $n == "$NODE" ]]; then
    LAB_CONF=$CONF "$SELF" "$@"
  else
    q="LAB_CONF=$(printf %q "$CONF") $(printf %q "$SELF")"
    for a in "$@"; do q+=" $(printf %q "$a")"; done
    ssh -o BatchMode=yes -o ConnectTimeout=10 -o HostKeyAlias="$n" "root@$(node_addr "$n")" "$q"
  fi
}

reach() {  # reach <node...>: every node runs this script over ssh, before anything changes
  local n
  for n in $(printf '%s\n' "$@" | sort -u); do
    [[ -z $n || $n == "$NODE" ]] || run_on "$n" _ping >/dev/null || die "cannot run the script on $n over ssh"
  done
}

slot_nodes() {  # Nodes of NODES that have slots, in NODES order
  local n id
  for n in "${NODE_NAMES[@]}"; do
    for id in "${SLOT_IDS[@]}"; do
      if [[ ${SLOT_NODE[$id]:-} == "$n" ]]; then echo "$n"; break; fi
    done
  done
}

cmd_deploy() {
  need_cluster
  local n nodes=() moodle_node
  [[ -n $MANAGER_NODE ]] || die "manager CT $MANAGER_VMID does not exist and CREATE_MANAGER is not set"
  mapfile -t nodes < <(slot_nodes)
  ((${#nodes[@]})) || die "no slot has a node: create the slots or plan them in CREATE_SLOTS"
  moodle_node=$MANAGER_NODE
  if [[ -n ${MOODLE_VMID:-} ]]; then
    moodle_node=$(ct_node "$MOODLE_VMID") || die "MOODLE_VMID $MOODLE_VMID is not a CT of this cluster"
  fi
  log "ssh to every node"
  reach "${nodes[@]}" "$MANAGER_NODE" "$moodle_node" "$TEMPLATE_NODE"

  if [[ -n $TEMPLATE_VMID ]]; then run_on "$TEMPLATE_NODE" template; fi
  run_on "$NODE" create
  run_on "$NODE" secrets
  run_on "${nodes[0]}" venv slot
  for n in "${nodes[@]}"; do
    run_on "$n" slot
    run_on "$n" agent
  done
  run_on "$MANAGER_NODE" venv manager
  run_on "$MANAGER_NODE" manager
  run_on "$moodle_node" moodle
  for n in "${nodes[@]}"; do [[ $n == "$MANAGER_NODE" ]] || run_on "$n" check; done
  run_on "$MANAGER_NODE" check
  run_on "$MANAGER_NODE" enable
  log "deployed: start a lab from Moodle; the plugin settings are in $S/moodle/plugin.txt"
}

cmd_destroy() {  # On the CT's node: _destroy <vmid> [template]
  local id=$1
  [[ $id != "${MOODLE_VMID:-}" ]] || die "refusing to destroy the Moodle CT $id"
  [[ -f /etc/pve/lxc/$id.conf ]] || return 0
  # Release builders and their clean templates (install/RELEASES.md) belong to lab-release.py.
  ! pct config "$id" | grep -qE '^tags:.*(^|[ ;,])labrelease-template([ ;,]|$)' ||
    die "CT $id is a release builder or its template (tag labrelease-template): reset never destroys it"
  if pct config "$id" | grep -q '^template: 1' && [[ ${2:-} != template ]]; then
    log "CT $id is a template: kept (reset --template destroys it)"
    return 0
  fi
  log "destroying CT $id ($(pct config "$id" | sed -n 's/^hostname: //p'))"
  [[ $(ct_state "$id") == stopped ]] || pct stop "$id"
  # Bind mounts (code, student directories, images) are host paths: destroy never touches them.
  pct destroy "$id" --purge 1 --destroy-unreferenced-disks 1
}

cmd_node_reset() {  # On every node: the agent forgets the owners of slots that no longer exist
  local d=/var/lib/lab-node-agent id
  [[ -d $d ]] || return 0
  systemctl stop lab-node-agent 2>/dev/null || true
  for id in "${SLOT_IDS[@]}"; do
    [[ -e $d/$id.json ]] || continue
    if ct_node "$id" >/dev/null; then warn "CT $id still exists: its ownership record stays"; continue; fi
    find "$d" -maxdepth 1 \( -name "$id.json" -o -name ".$id.*" \) -delete
    log "$NODE: ownership record of slot $id removed"
  done
  if systemctl is-enabled --quiet lab-node-agent 2>/dev/null; then systemctl start lab-node-agent; fi
}

cmd_reset() {
  need_cluster
  local yes=0 secrets=0 template=0 a id n ts students
  for a in "$@"; do
    case $a in
      --yes) yes=1 ;;
      --secrets) secrets=1 ;;
      --template) template=1 ;;
      *) die "reset: unknown option $a" ;;
    esac
  done
  ts=$(date +%Y%m%d-%H%M%S)
  students=$CEPH_ROOT/$STUDENTS_DIR
  log "reset destroys:"
  [[ -z $MANAGER_NODE ]] || echo "  manager CT $MANAGER_VMID on $MANAGER_NODE, with its database"
  for id in "${SLOT_IDS[@]}"; do [[ -z ${SLOT_NODE[$id]} ]] || echo "  slot CT $id on ${SLOT_NODE[$id]}"; done
  if ((template)) && [[ -n $TEMPLATE_VMID ]]; then echo "  slot template $TEMPLATE_VMID"; fi
  echo "  the agents' ownership records of these slots"
  [[ ! -d $students ]] || echo "  student data: $students is renamed to $students.reset-$ts"
  ((!secrets)) || echo "  secrets: $S is renamed to $S.reset-$ts (lab.conf and your own files are copied back)"
  if ((!yes)); then
    [[ -t 0 ]] || die "reset asks for confirmation: run it in a terminal or pass --yes"
    read -r -p "Type $PUBLIC_NAME to confirm: " a
    [[ $a == "$PUBLIC_NAME" ]] || die "not confirmed"
  fi

  reach "$MANAGER_NODE" "${SLOT_NODE[@]}" "$TEMPLATE_NODE" "${NODE_NAMES[@]}"
  [[ -z $MANAGER_NODE ]] || run_on "$MANAGER_NODE" _destroy "$MANAGER_VMID"
  for id in "${SLOT_IDS[@]}"; do [[ -z ${SLOT_NODE[$id]} ]] || run_on "${SLOT_NODE[$id]}" _destroy "$id"; done
  if ((template)) && [[ -n $TEMPLATE_VMID ]] && n=$(ct_node "$TEMPLATE_VMID"); then
    run_on "$n" _destroy "$TEMPLATE_VMID" template
  fi
  # A new database counts command epochs from 1 again: an agent that still remembered a higher one for
  # a VMID would refuse the new manager there (STALE_OWNER). The CTs are gone, so are their records.
  for n in "${NODE_NAMES[@]}"; do run_on "$n" _node-reset; done
  if [[ -d $students ]]; then
    mv "$students" "$students.reset-$ts"
    log "student data moved to $students.reset-$ts (delete it when it is not needed)"
  fi
  if ((secrets)); then
    mv "$S" "$S.reset-$ts"
    install -d -m 0700 "$S"
    local own=("${CONF#"$S"/}" manager/images.json manager/manager.env.local slot/iourc)
    # A gw certificate from a real CA is the operator's; one from the old test web CA is re-issued.
    a=$S.reset-$ts/manager/nginx
    if [[ -s $a/gw.crt ]] && ! openssl verify -CAfile "$S.reset-$ts/ca/web-ca.crt" "$a/gw.crt" >/dev/null 2>&1; then
      own+=(manager/nginx/gw.crt manager/nginx/gw.key)
    fi
    for a in "${own[@]}"; do
      [[ $a != /* && -e $S.reset-$ts/$a ]] || continue
      install -d -m 0700 "$(dirname "$S/$a")"
      cp -p "$S.reset-$ts/$a" "$S/$a"
    done
    log "secrets moved to $S.reset-$ts: after deploy Moodle needs the new site secret (moodle step)"
  fi
  log "reset done: 'lab-provision deploy' builds the stand again"
}

main() {
  local step=${1:-}
  [[ -n $step && $step != -h && $step != --help ]] || { usage; exit 0; }
  shift
  if [[ $step == release ]]; then
    # Separate, trusted verifier: no production lab.conf, pct or secrets for verify/list.
    local provision_path
    provision_path=$(/usr/bin/readlink -f "$0")
    exec /usr/bin/python3 -I -B "${provision_path%/*}/lab-release.py" "$@"
  fi
  case $step in
    template | create | deploy | reset | _create-manager | _clone-slot | _destroy | _node-reset | _ping) LENIENT=1 ;;
  esac
  load_conf
  case $step in
    secrets) cmd_secrets ;;
    venv) cmd_venv "$@" ;;
    slot) cmd_slot "$@" ;;
    snapshot) cmd_snapshot "$@" ;;
    agent) cmd_agent ;;
    manager) cmd_manager ;;
    moodle) cmd_moodle ;;
    check) cmd_check ;;
    enable) cmd_enable "$@" ;;
    reconcile) cmd_reconcile "$@" ;;
    template) cmd_template ;;
    create) cmd_create ;;
    deploy) cmd_deploy ;;
    reset) cmd_reset "$@" ;;
    # Internal: what deploy, create and reset run on each node
    _create-manager) cmd_create_manager ;;
    _clone-slot) cmd_clone_slot "$@" ;;
    _destroy) cmd_destroy "$@" ;;
    _node-reset) cmd_node_reset ;;
    _ping) echo "$NODE ok" ;;
    _slot-state) cmd_slot_state "$@" ;;
    *) usage; exit 2 ;;
  esac
}

[[ ${BASH_SOURCE[0]} != "$0" ]] || main "$@"  # Sourced (install/tests): only the functions
