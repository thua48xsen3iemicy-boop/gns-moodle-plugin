# Settings of install/lab-provision. Copy to /mnt/pve/cfs/secrets/lab.conf (root, 0600) and edit.
# No secrets here: the script generates them into SECRETS_DIR. One file for the whole cluster: every
# node with slots runs a node agent, the manager LXC lives on one of them.

# CephFS: the repository checkout (gns3-ro), student data (gns3-rw) and secrets, one filesystem.
CEPH_ROOT=/mnt/pve/cfs
REPO_DIR=/mnt/pve/cfs/gns3-ro
STUDENTS_DIR=gns3-rw/students
# GNS3 images shared by all slots (QEMU/, IOU/, firmware), below CEPH_ROOT: the agent mounts it
# read-only at /opt/gns3/images of every slot (mp2). Empty: images stay in each slot's rootfs.
IMAGES_DIR=gns3-images
SECRETS_DIR=/mnt/pve/cfs/secrets

# Proxmox nodes with slots, <node name>=<IP on the management network>. The agent of each node is
# reached as https://<node>.<AGENT_DOMAIN>:8443, its certificate is issued for that name and IP.
# (An older one-node lab.conf with NODE_IP=<IP> instead of NODES still works.)
NODES="pve1=10.10.12.9"
AGENT_DOMAIN=lab.local

# LXC VMIDs in the cluster. The script finds each CT's node and net0 IP in /etc/pve/nodes itself.
# Slots: unprivileged, static IP in net0, all from one template (same gns3 uid/gid). The VMIDs of a
# node's slots form its agent's range (min..max), so blocks per node are handy: 20xx, 21xx.
MANAGER_VMID=1900
SLOTS="2001"

# Placement limits per node (manager/docs/DESIGN.md §6.2). Hyperconverged nodes: the guests may hold
# at most this much memory, MiB (116 GiB of 128), the rest is the host's and Ceph's; and at most
# this many vCPUs per node CPU (Proxmox counts threads). Empty: no limit.
NODE_GUEST_MEMORY_MB=118784
NODE_CPU_OVERCOMMIT=2

# nginx in the manager LXC: https://<PUBLIC_NAME>/api/ for the Moodle server,
# wss://<PUBLIC_NAME>/console/ for browsers. The certificate is issued by the web CA (secrets/ca/web-ca.crt).
PUBLIC_NAME=labs.example.edu

# Moodle: exactly $CFG->wwwroot, the address its server uses to reach PUBLIC_NAME,
# and (optional) its LXC on this node, which then gets the web CA and a hosts entry.
MOODLE_URL=https://moodle.example.edu
MOODLE_IP=10.10.12.60
MOODLE_VMID=
SITE_SLUG=main

# ---- CTs the script creates itself (steps template, create, deploy). Optional: without these
# variables the CTs above must exist already, as before. An existing CT is never recreated.
# Storage of the CT root disks. Slots on other nodes are cloned there, so it must be shared (RBD).
CT_STORAGE=ceph-ct
CT_BRIDGE=vmbr0
CT_CIDR=24
CT_GATEWAY=10.10.12.1
CT_NAMESERVER=10.10.12.1
#CT_SEARCHDOMAIN=lab.local
#CT_VLAN=
# Ubuntu 24.04 image (pveam). Empty: the newest ubuntu-24.04-standard, downloaded to 'local'.
#CT_OSTEMPLATE=local:vztmpl/ubuntu-24.04-standard_24.04-2_amd64.tar.zst

# Manager CT: <node>:<IP>; MANAGER_VMID is its VMID. PostgreSQL, nginx and the services go inside.
#CREATE_MANAGER="pve1:10.10.12.50"
#MANAGER_CORES=2
#MANAGER_MEMORY_MB=4096
#MANAGER_DISK_GB=16

# Slot template: <vmid>=<node>:<IP or dhcp>, outside the slot VMID ranges. The script builds it once:
# Ubuntu 24.04, GNS3 2.2.61, QEMU/KVM, ubridge, VPCS, IOU libraries, user gns3 (SLOT_GNS3_ID).
# The node needs /dev/kvm. IOU license: put it into $SECRETS_DIR/slot/iourc, the slot step installs it.
#SLOT_TEMPLATE="2000=pve1:dhcp"
#SLOT_GNS3_ID=1500
#SLOT_DISK_GB=32
# Slots cloned from the template: <vmid>=<node>:<IP>, every VMID also in SLOTS.
#CREATE_SLOTS="2001=pve1:10.10.12.101 2002=pve1:10.10.12.102"
# Kind of the slot clones. full (default): copies the whole disk, slow. linked: shares the template's
# disk (a snapshot on RBD), seconds, but the template cannot be removed or rebuilt while clones exist
# (make a new template under a new VMID instead), and the clones must stay on the template's storage.
#SLOT_CLONE=full
