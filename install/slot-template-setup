#!/bin/bash
# Builds the slot template by hand, inside an LXC you prepared yourself (unprivileged Ubuntu 24.04,
# nesting=1, working network). It does what 'lab-provision template' does in the CT it creates itself
# (TEMPLATE_SCRIPT, TEMPLATE_VERIFY and TEMPLATE_CLEAN there): keep the two in step.
# The host side cannot be done from inside the CT (dev0/dev1 passthrough, pct template):
# the script prints those commands, install/README.md has the whole sequence.
#
#   slot-template-setup install   packages, user gns3, GNS3 server (pinned, own venv), config, service
#   slot-template-setup verify    after dev0/dev1 are set on the host and the CT is restarted
#   slot-template-setup clean     last step: no machine identity and no sshd left; then pct template
#
# Environment: GNS3_ID  uid and gid of gns3, the same in every slot (default 1500; SLOT_GNS3_ID of lab.conf)
#              GNS3_VERSION  the only GNS3 server the slot supports (default 2.2.61)
# Runs as root inside the CT and refuses to run anywhere else: 'clean' wipes the machine id and
# removes sshd, which must never happen to a Proxmox node.
# Guest scripts are single-quoted on purpose: they expand inside the CT.
# shellcheck disable=SC2016
set -euo pipefail
umask 022

GNS3_ID=${GNS3_ID:-1500}
GNS3_VERSION=${GNS3_VERSION:-2.2.61}

log() { printf '==> %s\n' "$*"; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  sed -n '2,/^# Runs as root/p' "$0" | sed 's/^# \{0,1\}//'
}

guard() {
  [[ $EUID == 0 ]] || die "run as root"
  [[ $(systemd-detect-virt --container 2>/dev/null || true) == lxc ]] ||
    die "this is not an LXC container: run the script in the CT that will become the template (pct exec <vmid>), never on the Proxmox node"
  [[ ! -e /etc/pve ]] || die "/etc/pve exists: this is a Proxmox node, not a CT"
  # shellcheck source=/dev/null
  . /etc/os-release
  [[ ${VERSION_ID:-} == 24.04 ]] || die "Ubuntu ${VERSION_ID:-?}, the slot template needs 24.04"
  if [[ ! $GNS3_ID =~ ^[0-9]+$ ]] || ((GNS3_ID < 1000 || GNS3_ID > 65534)); then
    die "GNS3_ID must be a uid in 1000..65534 (gns3 must not be root), got '$GNS3_ID'"
  fi
}

cmd_install() {
  export DEBIAN_FRONTEND=noninteractive
  log "network"
  for _ in $(seq 1 30); do getent hosts archive.ubuntu.com >/dev/null && break; sleep 2; done
  getent hosts archive.ubuntu.com >/dev/null || die "archive.ubuntu.com does not resolve: check the CT network and DNS"

  log "packages: QEMU, Python 3.12, ubridge, VPCS, Dynamips, IOU libraries"
  apt-get update -qq
  apt-get install -y -qq software-properties-common ca-certificates curl openssl libcap2-bin \
    python3.12 python3.12-venv qemu-system-x86 qemu-utils >/dev/null
  add-apt-repository -y ppa:gns3/ppa >/dev/null
  dpkg --add-architecture i386
  apt-get update -qq
  apt-get install -y -qq ubridge vpcs dynamips gns3-iou >/dev/null
  setcap cap_net_admin,cap_net_raw=ep /usr/bin/ubridge

  log "user gns3 $GNS3_ID:$GNS3_ID"
  getent group gns3 >/dev/null || groupadd --gid "$GNS3_ID" gns3
  id gns3 >/dev/null 2>&1 ||
    useradd --uid "$GNS3_ID" --gid gns3 --home-dir /var/lib/gns3 --create-home --shell /usr/sbin/nologin gns3
  [[ $(id -u gns3):$(id -g gns3) == "$GNS3_ID:$GNS3_ID" ]] ||
    die "gns3 is $(id -u gns3):$(id -g gns3), expected $GNS3_ID:$GNS3_ID: remove the user and repeat"
  getent group kvm >/dev/null || groupadd --system kvm
  usermod -aG kvm gns3

  log "directories: mount points of the agent and the local GNS3 ones"
  install -d -m 0755 /srv/gns3-ro/slot /opt/gns3 /opt/gns3/projects /opt/gns3/images \
    /opt/gns3/images/QEMU /opt/gns3/images/IOU /etc/gns3
  install -d -o gns3 -g gns3 -m 0700 /opt/gns3/qga
  install -d -o gns3 -g gns3 -m 0750 /var/lib/gns3/configs /var/lib/gns3/appliances /var/lib/gns3/symbols

  log "GNS3 server $GNS3_VERSION in /opt/gns3-server"
  python3.12 -m venv --clear /opt/gns3-server
  /opt/gns3-server/bin/python -m pip install -q --disable-pip-version-check "gns3-server==$GNS3_VERSION"

  cat >/etc/gns3/gns3_server.conf <<'EOF'
# Generated by install/slot-template-setup
[Server]
host = 127.0.0.1
port = 3080
auth = False
images_path = /opt/gns3/images
projects_path = /opt/gns3/projects
configs_path = /var/lib/gns3/configs
appliances_path = /var/lib/gns3/appliances
symbols_path = /var/lib/gns3/symbols
ubridge_path = /usr/bin/ubridge
report_errors = False

[Qemu]
enable_hardware_acceleration = True
require_hardware_acceleration = True

[IOU]
iourc_path = /opt/gns3/iourc
license_check = True
EOF
  cat >/etc/systemd/system/gns3.service <<EOF
# Generated by install/slot-template-setup
[Unit]
Description=GNS3 server $GNS3_VERSION
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=gns3
Group=gns3
ExecStart=/opt/gns3-server/bin/gns3server --config /etc/gns3/gns3_server.conf
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable gns3.service >/dev/null 2>&1

  log "installed. Next, on the Proxmox node that hosts this CT (<vmid> is this CT):"
  echo "  pct set <vmid> -dev0 /dev/kvm,gid=$(getent group kvm | cut -d: -f3),mode=0660 -dev1 /dev/net/tun,mode=0666"
  echo "  pct shutdown <vmid> && pct start <vmid>      # devices are applied at start"
  echo "then in the CT: slot-template-setup verify"
}

cmd_verify() {
  local v=""
  [[ -x /opt/gns3-server/bin/gns3server ]] || die "GNS3 is not installed: run 'install' first"
  [[ $(id -u gns3):$(id -g gns3) == "$GNS3_ID:$GNS3_ID" ]] ||
    die "gns3 is $(id -u gns3):$(id -g gns3), expected $GNS3_ID:$GNS3_ID (GNS3_ID differs from the one used for install?)"
  systemctl is-enabled --quiet gns3.service || die "gns3.service is not enabled"
  systemctl restart gns3.service
  for _ in $(seq 1 30); do v=$(curl -fsS http://127.0.0.1:3080/v2/version 2>/dev/null) && break; sleep 2; done
  case $v in
    *"$GNS3_VERSION"*) log "GNS3: $v" ;;
    *) die "GNS3 $GNS3_VERSION does not answer on 127.0.0.1:3080 ($v): journalctl -u gns3 -n 50" ;;
  esac
  runuser -u gns3 -- test -r /dev/kvm -a -w /dev/kvm ||
    die "gns3 cannot use /dev/kvm: set dev0 on the host and restart the CT (the node needs /dev/kvm, Proxmox VE 8.1+)"
  test -c /dev/net/tun || die "no /dev/net/tun: set dev1 on the host and restart the CT"
  getcap /usr/bin/ubridge | grep -q cap_net_admin || die "ubridge has no capabilities"
  qemu-system-x86_64 --version | head -1
  log "verified. Next: slot-template-setup clean"
}

cmd_clean() {
  export DEBIAN_FRONTEND=noninteractive
  # pct exec passes the node's SSH_CONNECTION on, so look for a login session of this CT's own sshd.
  if command -v pgrep >/dev/null && pgrep -f '^sshd: .+@' >/dev/null; then
    die "clean removes sshd: run it with pct exec <vmid>, not over ssh into the CT"
  fi
  [[ -x /opt/gns3-server/bin/gns3server ]] || die "GNS3 is not installed: nothing to clean, run 'install' first"
  # Clones must not share anything that identifies one machine or one slot. Slots are reached with
  # pct only; a cloned sshd would share its host keys between all of them.
  systemctl stop gns3.service
  apt-get purge -y -qq openssh-server >/dev/null 2>&1 || true
  apt-get autoremove -y -qq >/dev/null
  rm -rf /var/lib/lab-slot /etc/lab-slot /opt/gns3/iourc /var/lib/gns3/.config
  find /tmp /var/tmp -mindepth 1 -delete
  apt-get clean
  truncate -s 0 /etc/machine-id
  rm -f /var/lib/dbus/machine-id
  journalctl --rotate >/dev/null 2>&1 || true
  journalctl --vacuum-time=1s >/dev/null 2>&1 || true
  log "clean. Do not start anything else in this CT. On the Proxmox node:"
  echo "  pct shutdown <vmid> && pct template <vmid>"
  echo "then SLOT_TEMPLATE=\"<vmid>=<node>:<ip>\" and CREATE_SLOTS in lab.conf, and 'lab-provision create'"
}

main() {
  case ${1:-} in
    install|verify|clean) guard; "cmd_$1" ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
