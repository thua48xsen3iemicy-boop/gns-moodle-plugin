# Copy to /etc/lab-manager/manager.env (root:lab-manager, chmod 640). Not in Git/CephFS.
# Without required values the service refuses to start.

# PostgreSQL in this LXC via the local socket, peer auth: no password needed.
DATABASE_URL=postgresql:///lab_manager

# JSON secret files (chmod 600, owner lab-manager). Examples: sites.json.example, slots.json.example
MANAGER_SITES_FILE=/etc/lab-manager/sites.json
MANAGER_SLOTS_FILE=/etc/lab-manager/slots.json

MANAGER_LISTEN_HOST=127.0.0.1
MANAGER_LISTEN_PORT=8090

# Lab catalog on RO CephFS: <lab_ref>/{lab.gns3,ticket.json,meta.json,checks/}
LABS_DIR=/srv/gns3-ro/labs

# Proxmox API (read-only use + CT sizing): entry points tried in a ring.
PVE_NODES=pve1:8006,pve2:8006,pve3:8006
PVE_TOKEN_ID=lab-manager@pve!manager
PVE_TOKEN_SECRET=REPLACE_WITH_TOKEN_SECRET
PVE_CA_FILE=/etc/lab-manager/pve-root-ca.pem
PVE_TIMEOUT=10
PVE_RETRY_AFTER=60

# Lab Node Agent on every Proxmox node (mTLS). {node} = Proxmox node name.
AGENT_URL_TEMPLATE=https://{node}.mgmt.example.edu:8443
AGENT_CA_FILE=/etc/lab-manager/agent-ca.pem
AGENT_CERT_FILE=/etc/lab-manager/manager.crt
AGENT_KEY_FILE=/etc/lab-manager/manager.key
AGENT_TIMEOUT=30
AGENT_START_TIMEOUT=330
AGENT_STOP_TIMEOUT=100
# Guest actions after pct start, in order (agent GUEST_ACTIONS); empty = none.
AGENT_START_ACTIONS=
# Empty: shared <LAB_CEPH_ROOT>/slot; otherwise <LAB_CEPH_ROOT>/slot/<revision>.
SLOT_CODE_REVISION=
# Mounted read-only into a released slot instead of the last student's directory.
PLACEHOLDER_STUDENT_KEY=placeholder

# Manager-local path of <LAB_CEPH_ROOT>/students (RW CephFS bind mount of this LXC).
STUDENT_ROOT=/srv/lab-students

# fresh: every session deploys a new GNS3 project (works with Lab Slot 0.3).
# resume: same project_id and ticket as last time; needs cold resume in Lab Slot (docs/DESIGN.md).
LAB_PERSISTENCE=fresh
# Memory kept free on every node when placing labs, MiB.
NODE_MEMORY_RESERVE_MB=2048

# Console gateway (plugin/gateway): internal ticket API and the public wss URL for browsers.
GATEWAY_INTERNAL_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_KEY=REPLACE_WITH_GW_INTERNAL_KEY
GATEWAY_PUBLIC_URL=wss://gateway.example.edu

# Lab Slot timeouts, seconds
SLOT_TIMEOUT=10
SLOT_READY_TIMEOUT=300
LAB_OPERATION_TIMEOUT=1800

# Minutes; the plugin's maxduration is not part of the SPEC §3 contract yet.
DEFAULT_MAX_DURATION=180
WORKER_INTERVAL=2
