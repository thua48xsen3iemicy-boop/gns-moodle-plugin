# Copy to /etc/lab-manager/manager.env (root:lab-manager, chmod 640 or 600). Not in Git/CephFS.
# Without required values the service refuses to start.

# PostgreSQL in this LXC via the local socket, peer auth: no password needed.
DATABASE_URL=postgresql:///lab_manager

# JSON secret files (chmod 600, owner lab-manager). Examples: sites.json.example, slots.json.example
MANAGER_SITES_FILE=/etc/lab-manager/sites.json
MANAGER_SLOTS_FILE=/etc/lab-manager/slots.json

MANAGER_LISTEN_HOST=127.0.0.1
MANAGER_LISTEN_PORT=8090

# Lab catalog on RO CephFS: <lab_ref>/{lab.gns3,ticket.json,meta.json,checks/}
LABS_DIR=/srv/gns3-ro/labs

# Proxmox: entry points tried in a ring, last working one first.
PVE_NODES=pve1:8006,pve2:8006,pve3:8006
PVE_TOKEN_ID=lab-manager@pve!manager
PVE_TOKEN_SECRET=REPLACE_WITH_TOKEN_SECRET
PVE_CA_FILE=/etc/lab-manager/pve-root-ca.pem
PVE_TIMEOUT=10
PVE_RETRY_AFTER=60
PVE_TASK_TIMEOUT=120
CT_SHUTDOWN_TIMEOUT=60

# Student directory: handover (default) | pve_config | none. See docs/DESIGN.md.
STUDENT_MOUNT_MODE=handover
STUDENT_ROOT=/srv/lab-rw/students
SLOT_MOUNT_ROOT=/srv/lab-rw/slots
# The service user must have the same numeric uid as gns3 inside the slots (README, «UID»).
# Only for pve_config:
#PVE_STUDENT_HOST_ROOT=/mnt/pve/cephfs/lab/students
#STUDENT_MP_INDEX=0
#STUDENT_MP_TARGET=/opt/gns3/student

# Console gateway (plugin/gateway): internal ticket API and the public wss URL for browsers.
GATEWAY_INTERNAL_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_KEY=REPLACE_WITH_GW_INTERNAL_KEY
GATEWAY_PUBLIC_URL=wss://gateway.example.edu

# Lab Slot timeouts, seconds
SLOT_TIMEOUT=10
SLOT_READY_TIMEOUT=300
LAB_OPERATION_TIMEOUT=1800

# Minutes; the plugin's maxduration is not part of the SPEC §3 contract yet.
DEFAULT_MAX_DURATION=180
WORKER_INTERVAL=2
