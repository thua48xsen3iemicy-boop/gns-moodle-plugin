{{!
    @template mod_gns3lab/viewer

    Topology viewer of a GNS3 lab: inline on the activity page or full screen.

    Context variables required for this template:
    * fullscreen - render the full screen variant
    * labname - activity name
    * fullscreenurl - URL of the full screen page
    * backurl - URL of the activity page
    * isdemo - demo data is shown
    * previewerror - the reference lab could not be loaded from the lab manager
    * cancontrol - the user can start the lab: show the session bar and the consoles
    * cmid - course module id
    * datajson - JSON with topology, live (node states, guests) and facts (ok, broken)

    Example context (json):
    {
        "fullscreen": false,
        "labname": "Lab 4",
        "fullscreenurl": "https://example.org/mod/gns3lab/lab.php?id=1",
        "backurl": "https://example.org/mod/gns3lab/view.php?id=1",
        "isdemo": true,
        "previewerror": false,
        "cancontrol": true,
        "cmid": 1,
        "datajson": "{}"
    }
}}
{{^fullscreen}}
<div class="d-flex flex-wrap align-items-center gap-3 mb-3">
    <a class="btn btn-primary" href="{{fullscreenurl}}">{{#str}}openfullscreen, mod_gns3lab{{/str}}</a>
    {{#isdemo}}
    <p class="text-muted small mb-0 flex-grow-1">{{#str}}demonotice, mod_gns3lab{{/str}}</p>
    {{/isdemo}}
    {{#previewerror}}
    <p class="text-danger small mb-0 flex-grow-1">{{#str}}previewerror, mod_gns3lab{{/str}}</p>
    {{/previewerror}}
</div>
{{/fullscreen}}
<div class="gns3lab-app {{#fullscreen}}is-fullscreen{{/fullscreen}}{{^fullscreen}}is-inline{{/fullscreen}}" id="{{uniqid}}-app" data-json="{{datajson}}">
    <header class="bar">
        <div class="ttl">
            {{#fullscreen}}
            <a class="gbtn back" href="{{backurl}}" title="{{#str}}backtoactivity, mod_gns3lab{{/str}}" aria-label="{{#str}}backtoactivity, mod_gns3lab{{/str}}">&larr;</a>
            {{/fullscreen}}
            <div>
                <h2 class="ttl-h" id="{{uniqid}}-projName">{{labname}}</h2>
                <p class="meta" id="{{uniqid}}-meta"></p>
            </div>
        </div>
        <div class="tools">
            <span class="ro" title="{{#str}}readonly_help, mod_gns3lab{{/str}}">{{#str}}readonly, mod_gns3lab{{/str}}</span>
            <div class="seg" id="{{uniqid}}-layerSeg" role="group" aria-label="{{#str}}layers, mod_gns3lab{{/str}}">
                <button type="button" data-layer="l1" aria-pressed="true" title="{{#str}}layer_l1, mod_gns3lab{{/str}}">L1</button>
                <button type="button" data-layer="l2" aria-pressed="false" title="{{#str}}layer_l2, mod_gns3lab{{/str}}">L2</button>
                <button type="button" data-layer="l3" aria-pressed="false" title="{{#str}}layer_l3, mod_gns3lab{{/str}}">L3</button>
                <button type="button" data-layer="rt" aria-pressed="false" title="{{#str}}layer_rt, mod_gns3lab{{/str}}">OSPF</button>
            </div>
            <select class="sel" id="{{uniqid}}-factsSel" aria-label="{{#str}}facts, mod_gns3lab{{/str}}" title="{{#str}}facts_help, mod_gns3lab{{/str}}">
                <option value="ok">{{#str}}factsok, mod_gns3lab{{/str}}</option>
                <option value="broken">{{#str}}factsbroken, mod_gns3lab{{/str}}</option>
            </select>
            <button class="gbtn" id="{{uniqid}}-btnFit" type="button" title="{{#str}}fit_help, mod_gns3lab{{/str}}">{{#str}}fit, mod_gns3lab{{/str}}</button>
            <div class="zoomgrp" role="group" aria-label="{{#str}}zoom, mod_gns3lab{{/str}}">
                <button class="gbtn" id="{{uniqid}}-btnOut" type="button" aria-label="{{#str}}zoomout, mod_gns3lab{{/str}}">&minus;</button>
                <output id="{{uniqid}}-zoomPct" aria-live="off">100%</output>
                <button class="gbtn" id="{{uniqid}}-btnIn" type="button" aria-label="{{#str}}zoomin, mod_gns3lab{{/str}}">+</button>
            </div>
            <button class="gbtn" id="{{uniqid}}-btnStatus" type="button" aria-pressed="false" title="{{#str}}livedata_help, mod_gns3lab{{/str}}">{{#str}}livedata, mod_gns3lab{{/str}}</button>
            <label class="gbtn" for="{{uniqid}}-fileInput">{{#str}}openfile, mod_gns3lab{{/str}}</label>
            <input class="vh" type="file" id="{{uniqid}}-fileInput" accept=".gns3,.json,application/json">
        </div>
    </header>
    {{#cancontrol}}
    <div class="ctl" data-region="control">
        <span class="cstatus" data-region="status" role="status"></span>
        <span class="ctime" data-region="timeleft" hidden></span>
        <span class="cmsg" data-region="message" role="alert" hidden></span>
        <span class="cbtns">
            <button class="gbtn primary" type="button" data-region="start" hidden>{{#str}}startlab, mod_gns3lab{{/str}}</button>
            <button class="gbtn" type="button" data-region="stop" hidden>{{#str}}stoplab, mod_gns3lab{{/str}}</button>
        </span>
    </div>
    {{/cancontrol}}

    <div class="stage">
        <div class="wrap" id="{{uniqid}}-wrap">
            <svg class="gns3lab-svg" id="{{uniqid}}-svg" xmlns="http://www.w3.org/2000/svg" tabindex="0" aria-label="{{#str}}topology, mod_gns3lab{{/str}}">
            <defs>
                <pattern id="{{uniqid}}-dots" width="24" height="24" patternUnits="userSpaceOnUse">
                <circle style="fill:var(--grid)" cx="1.2" cy="1.2" r="1.2"/>
                </pattern>
                <symbol id="{{uniqid}}-ico-router" viewBox="0 0 48 48">
                <circle style="fill:var(--ico)" cx="24" cy="24" r="20"/>
                <path style="fill:none;stroke:var(--ico-glyph);stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round" d="M14 14l7 7M21 15.5V21h-5.5M34 34l-7-7M27 32.5V27h5.5M27 21l7-7M28.5 14H34v5.5M21 27l-7 7M14 28.5V34h5.5"/>
                </symbol>
                <symbol id="{{uniqid}}-ico-switch" viewBox="0 0 48 48">
                <rect style="fill:var(--ico)" x="3" y="12" width="42" height="24" rx="5"/>
                <path style="fill:none;stroke:var(--ico-glyph);stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round" d="M10 20h22M28 16.5l4 3.5-4 3.5M38 28H16M20 24.5L16 28l4 3.5"/>
                </symbol>
                <symbol id="{{uniqid}}-ico-pc" viewBox="0 0 48 48">
                <rect style="fill:var(--ico)" x="6" y="6" width="36" height="26" rx="3"/>
                <rect style="fill:var(--ico-glyph)" x="10" y="10" width="28" height="18" rx="1.5" opacity=".35"/>
                <path style="fill:var(--ico)" d="M20 32h8v6h-8z"/>
                <rect style="fill:var(--ico)" x="13" y="38" width="22" height="4" rx="2"/>
                </symbol>
                <symbol id="{{uniqid}}-ico-server" viewBox="0 0 48 48">
                <rect style="fill:var(--ico)" x="11" y="4" width="26" height="40" rx="3.5"/>
                <path style="fill:none;stroke:var(--ico-glyph);stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round" d="M16 13h16M16 19h16M16 25h16"/>
                <circle style="fill:var(--ico-glyph)" cx="31" cy="36" r="2.2"/>
                </symbol>
                <symbol id="{{uniqid}}-ico-cloud" viewBox="0 0 48 48">
                <path style="fill:var(--ico)" d="M13 37h22a8.5 8.5 0 0 0 1.2-16.9A11.5 11.5 0 0 0 14 17.6 9.7 9.7 0 0 0 13 37z"/>
                </symbol>
                <symbol id="{{uniqid}}-ico-firewall" viewBox="0 0 48 48">
                <rect style="fill:var(--ico)" x="5" y="9" width="38" height="30" rx="2.5"/>
                <path style="fill:none;stroke:var(--ico-glyph);stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round" d="M5 19h38M5 29h38M18 9v10M30 9v10M12 19v10M24 19v10M36 19v10M18 29v10M30 29v10"/>
                </symbol>
                <symbol id="{{uniqid}}-ico-hypervisor" viewBox="0 0 48 48">
                <rect style="fill:var(--ico)" x="4" y="7" width="40" height="34" rx="4"/>
                <rect style="fill:var(--ico-glyph)" x="9" y="12" width="13" height="10" rx="1.5"/>
                <rect style="fill:var(--ico-glyph)" x="26" y="12" width="13" height="10" rx="1.5"/>
                <rect style="fill:var(--ico-glyph)" x="9" y="26" width="13" height="10" rx="1.5"/>
                <rect x="26" y="26" width="13" height="10" rx="1.5" style="fill:none;stroke:var(--ico-glyph);stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round"/>
                </symbol>
            </defs>
                <rect width="100%" height="100%" fill="url(#{{uniqid}}-dots)"/>
                <g id="{{uniqid}}-vp">
                    <g class="drawings" id="{{uniqid}}-lyrDraw"></g>
                    <g id="{{uniqid}}-lyrLinks"></g>
                    <g id="{{uniqid}}-lyrNodes"></g>
                    <g id="{{uniqid}}-lyrLabels"></g>
                </g>
            </svg>
            <p class="hint">{{#str}}hint, mod_gns3lab{{/str}}</p>
            <div class="gtoast" id="{{uniqid}}-toast" role="status" hidden></div>
            <div class="drop" id="{{uniqid}}-drop" hidden>{{#str}}drop, mod_gns3lab{{/str}}</div>
        </div>

        <aside class="panel" id="{{uniqid}}-panel" aria-label="{{#str}}details, mod_gns3lab{{/str}}">
            <button class="handle" id="{{uniqid}}-handle" type="button" aria-expanded="false" aria-controls="{{uniqid}}-panelBody"><span id="{{uniqid}}-handleText"></span></button>
            <div class="panelbody" id="{{uniqid}}-panelBody"></div>
        </aside>
    </div>
    {{#cancontrol}}
    <section class="gns3lab-consoles" data-region="consoles" aria-label="{{#str}}consoles, mod_gns3lab{{/str}}" hidden>
        <div class="ctabs" data-region="tabs" role="tablist"></div>
        <p class="obsbar" data-region="obsbar" hidden>{{#str}}consolereadonly, mod_gns3lab{{/str}}</p>
        <div class="ctermhost" data-region="termhost">
            <div class="ctoast" data-region="toast" role="status" hidden></div>
        </div>
        <div class="strip" data-region="keys"></div>
        <div class="strip" data-region="snippets"></div>
    </section>
    {{/cancontrol}}
</div>
{{#js}}
require(['mod_gns3lab/viewer'], function(viewer) {
    viewer.init('{{uniqid}}');
});
{{#cancontrol}}
require(['mod_gns3lab/lab'], function(lab) {
    lab.init('{{uniqid}}', {{cmid}});
});
{{/cancontrol}}
{{/js}}
