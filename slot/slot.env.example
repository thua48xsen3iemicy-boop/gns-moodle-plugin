# Copy ON EACH LXC to /etc/lab-slot/slot.env (chmod 600, root-owned).
# Generate token on the LXC: openssl rand -hex 32
# Do not commit the real secret to Git/CephFS RO.
SLOT_API_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
GNS3_API_URL=http://127.0.0.1:3080/v2

# Console-only token for the console gateway (WS /v1/console); does not open the REST API.
# Generate separately: openssl rand -hex 32. Leave empty if no gateway uses this slot.
SLOT_CONSOLE_TOKEN=
# 127.0.0.1 by default. Set the LXC address only with a firewall allowing Manager and gateway.
SLOT_LISTEN_HOST=127.0.0.1
SLOT_TLS_CERT_FILE=/etc/lab-slot/tls/server.crt
SLOT_TLS_KEY_FILE=/etc/lab-slot/tls/server.key

SLOT_STATE_DIR=/var/lib/lab-slot
SLOT_PROJECT_LOCK_DIR=/opt/gns3/projects/.slot-locks
SLOT_READY_TIMEOUT=180
SLOT_MONITOR_INTERVAL=10
