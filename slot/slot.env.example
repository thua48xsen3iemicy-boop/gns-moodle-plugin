# Copy ON EACH LXC to /etc/lab-slot/slot.env (chmod 600, root-owned).
# Generate token on the LXC: openssl rand -hex 32
# Do not commit the real secret to Git/CephFS RO.
SLOT_API_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
GNS3_API_URL=http://127.0.0.1:3080/v2

# Console-only token for the console gateway (WS /v1/console); does not open the REST API.
# Generate separately: openssl rand -hex 32. Leave empty if no gateway uses this slot.
SLOT_CONSOLE_TOKEN=
# 127.0.0.1 by default. Set the LXC address only with a firewall allowing Manager and gateway.
SLOT_LISTEN_HOST=127.0.0.1
SLOT_TLS_CERT_FILE=/etc/lab-slot/tls/server.crt
SLOT_TLS_KEY_FILE=/etc/lab-slot/tls/server.key

SLOT_STATE_DIR=/var/lib/lab-slot
SLOT_PROJECT_LOCK_DIR=/opt/gns3/projects/.slot-locks
SLOT_READY_TIMEOUT=180
SLOT_MONITOR_INTERVAL=10

# IOL L1: interval between probes/keepalives, per-round reply deadline and consecutive misses.
# Reply timeout must be smaller than interval. Validate against the lab's IOL image.
SLOT_L1_INTERVAL=3
SLOT_L1_REPLY_TIMEOUT=0.75
SLOT_L1_MISSES=2
# QEMU carrier is gated by successful, fresh admin-up facts for the exact linked port.
SLOT_L1_FACT_MAX_AGE=90
# Existing QGA collectors; lowering the interval increases guest-agent load.
SLOT_FACTS_INTERVAL=30

# Cisco IOL facts (ios.config/1). GNS3 projects, and iou_export.py of the GNS3 venv (the slot's own venv cannot
# see gns3server); both lines show the defaults.
#SLOT_PROJECTS_DIR=/opt/gns3/projects
#SLOT_IOU_EXPORT=/opt/gns3-server/lib/python3.12/site-packages/gns3server/compute/iou/utils/iou_export.py

# Cisco IOL startup-config from the ticket (NodeSpec.nvram_config): iou_import.py of the same GNS3 venv, the default shown.
#SLOT_IOU_IMPORT=/opt/gns3-server/lib/python3.12/site-packages/gns3server/compute/iou/utils/iou_import.py
